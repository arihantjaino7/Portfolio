---
/**
 * Homepage — REDESIGN.md §1, §2. All six sections built: S1 landing, S2
 * achievements (numbered expanding rows), S3 work (hover-reveal rows), S4
 * about, S5 capabilities marquee, S6 outro. The generic engine (Reveal /
 * data-count / data-parallax) does the animating; nothing here hand-rolls a
 * one-off tween.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { assets } from '../config/assets';
import { withBase } from '../config/paths';
import { person, achievements, skills, links } from '../config/site';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const skillItems = skills.flatMap((g) => g.items);
---

<Base ogImage={assets.og('default')} hideFooter>
  <!--
    Armed before first paint. Kept from the previous build: later phases that
    need a load-only entrance (not a scroll-triggered one) key off this class
    the same way the old hero did, without waiting on the motion bundle.
  -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion-pending');
    }
  </script>

  <!-- S1 — landing -->
  <section id="landing" class="screen landing">
    <HeroCanvas />
    <div class="landing-inner shell">
      <div class="landing-hero">
        <Reveal
          as="h1"
          class="landing-name"
          lines={[person.name.split(' ')[0], person.name.split(' ').slice(1).join(' ')]}
        />
        <Reveal as="p" class="landing-statement" delay={0.12}>{person.statement}</Reveal>
      </div>
      <div class="landing-meta">
        <span class="meta">{person.location}</span>
        <span class="meta" id="local-time" data-tz="Asia/Kolkata" aria-live="off"></span>
        <span class="meta landing-scroll" id="scroll-cue">scroll ↓</span>
      </div>
    </div>
  </section>

  <!-- S2 — achievements, sticky-stacked full-height panels -->
  <section id="achievements" class="dark-panel achievements">
    <div class="shell achievements-intro">
      <Reveal as="h2" class="achievements-title" lines={['Achievements']} />
      <div class="intro-row">
        <span class="tag meta">({String(achievements.length).padStart(2, '0')})</span>
        <Reveal as="p" class="achievements-lede" delay={0.1}>
          Three ranked results from 2026. Scroll for the short version of each.
        </Reveal>
      </div>
    </div>

    <!--
      The stack effect is pure CSS `position: sticky` — each panel sticks one
      head-height lower than the one before it, and carries an opaque ground so
      the next panel occludes the previous panel's body while its head stays
      pinned. No ScrollTrigger pinning, which means it behaves identically with
      JS disabled and under prefers-reduced-motion: it is layout, not animation.
      `--i` drives both the sticky offset and the panel height so the two can
      never drift apart.
    -->
    <ol class="stack">
      {
        achievements.map((a, i) => (
          <li class="stack-item" style={`--i:${i}`}>
            <article class="ach">
              <div class="ach-inner">
                <div class="ach-head">
                  <span class="ach-index">{String(i + 1).padStart(2, '0')}.</span>
                  <span class="ach-figure">
                    {a.prefix}<span data-count={a.value}>{a.value}</span>{a.suffix}
                  </span>
                  <h3 class="ach-event">{a.event}</h3>
                  <span class="ach-year meta">{a.year}</span>
                  <span class="ach-arrow" aria-hidden="true">↙</span>
                </div>
                <div class="ach-body">
                  <p class="ach-detail meta">{a.detail}</p>
                  <p class="ach-blurb">{a.blurb}</p>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- S3 — work -->
  <section id="work" class="work-section">
    <div class="shell">
      <div class="work-head">
        <Reveal as="h2" class="section-title" lines={['Work']} />
        <span class="meta">{String(projects.length).padStart(2, '0')} case studies</span>
      </div>
      <ol class="project-rows">
        {
          projects.map((p, i) => (
            <li>
              <a class="project-row" href={withBase(`/work/${p.id}`)}>
                <span class="meta idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="project-thumb frame" aria-hidden="true">
                  <img
                    src={assets.project(p.id).shot1}
                    alt=""
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="project-title">{p.data.title}</span>
                <span class="project-row-meta meta">
                  <span class="project-view">View case →</span>
                  <span>{p.data.year}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <a class="meta u all-work" href={withBase('/work')}>All work →</a>
    </div>
  </section>

  <!-- S4 — about -->
  <section id="about" class="screen dark-panel about-section">
    <div class="shell about-grid">
      <div class="about-portrait frame" data-reveal="clip">
        <img
          src={assets.portrait}
          alt={`${person.name}, portrait`}
          width="480"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-copy">
        <Reveal as="p" class="about-kicker" lines={['Hey —']} />
        <Reveal as="h2" class="about-name" lines={[`I'm ${person.name}.`]} delay={0.08} />
        <Reveal as="p" class="about-statement" delay={0.16}>{person.statement}</Reveal>
        <div class="about-row">
          <span class="tag meta">About me</span>
          <a class="meta u" href={withBase('/about')}>More about me →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- S5 — capabilities marquee -->
  <section id="capabilities" class="capabilities-section" aria-hidden="true">
    <div class="marquee-row">
      <div class="marquee-track marquee-left">
        {[...skillItems, ...skillItems].map((s) => <span class="meta">{s}</span>)}
      </div>
    </div>
    <div class="marquee-row">
      <div class="marquee-track marquee-right">
        {[...skillItems, ...skillItems].map((s) => <span class="meta">{s}</span>)}
      </div>
    </div>
  </section>

  <!-- S6 — outro -->
  <section id="outro" class="screen dark-panel outro">
    <div class="shell outro-inner">
      <Reveal as="p" class="outro-line" lines={["Let's build", 'something.']} />
      <a
        id="outro-email"
        class="outro-email"
        href={links.email}
        data-email={person.email}
      >
        {person.email}
      </a>
      <ul class="outro-links">
        <li><a class="meta u" href={links.github} rel="me noopener">GitHub ↗</a></li>
        <li><a class="meta u" href={links.linkedin} rel="me noopener">LinkedIn ↗</a></li>
        <li><a class="meta u" href={links.email}>Email ↗</a></li>
      </ul>
      <div class="outro-footer meta">
        <span>© {new Date().getFullYear()} {person.name}</span>
        <span>
          {person.location} — <span id="outro-time" data-tz="Asia/Kolkata"></span>
        </span>
        <a class="u" href="#landing">Back to top ↑</a>
      </div>
    </div>
  </section>

  <!--
    A handful of page-specific bits — a live clock (×2), a one-shot scroll
    cue, click-to-copy email — unrelated to the reveal/parallax/count
    vocabulary motion.ts generalizes, so they aren't routed through that
    engine. Independent of prefers-reduced-motion: they update text and
    toggle classes, they don't animate. The mailto href is real from the
    start, so copy-to-clipboard is a progressive enhancement, not the only
    path — email still works with this script absent.
  -->
  <script>
    function liveClock(el: HTMLElement) {
      const tz = el.dataset.tz ?? 'Asia/Kolkata';
      const fmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: tz,
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      });
      const update = () => (el.textContent = fmt.format(new Date()));
      update();
      setInterval(update, 30_000);
    }
    document
      .querySelectorAll<HTMLElement>('#local-time, #outro-time')
      .forEach(liveClock);

    const cue = document.getElementById('scroll-cue');
    if (cue) {
      window.addEventListener('scroll', () => cue.classList.add('is-hidden'), {
        once: true,
        passive: true,
      });
    }

    const emailLink = document.getElementById('outro-email');
    if (emailLink && navigator.clipboard) {
      emailLink.addEventListener('click', (e) => {
        const address = emailLink.dataset.email;
        if (!address) return;
        e.preventDefault();
        navigator.clipboard.writeText(address).then(() => {
          const original = emailLink.textContent;
          emailLink.textContent = 'copied';
          setTimeout(() => (emailLink.textContent = original), 1500);
        });
      });
    }
  </script>

  <!-- Home only — every other route stays at zero client JS. -->
  <script>
    import '../scripts/motion';
  </script>
</Base>

<style>
  .screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* ── S1 landing ─────────────────────────────────────────────── */
  .landing {
    position: relative;
    align-items: stretch;
    overflow: hidden;
  }

  .landing-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .landing-hero {
    align-self: center;
  }

  /* :global — these classes land on <Reveal>'s own root element, which
     carries Reveal.astro's scope hash rather than this file's, so a plain
     scoped selector here would silently never match. Same story everywhere
     else below that styles a class passed into <Reveal>. */
  .landing-hero :global(.landing-name) {
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .landing-hero :global(.landing-statement) {
    margin: 1.25rem 0 0;
    max-width: 34ch;
    color: var(--color-muted);
    font-size: clamp(1rem, 0.6vw + 0.85rem, 1.25rem);
  }

  .landing-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .landing-scroll {
    transition: opacity 500ms ease;
  }

  .landing-scroll.is-hidden {
    opacity: 0;
  }

  /* ── shared section heading ─────────────────────────────────── */
  :global(.section-title) {
    font-size: var(--text-chapter);
    font-weight: 600;
    margin: 0;
  }

  /* ── S2 achievements — sticky-stacked panels ────────────────── */
  /* One set of column measures drives the head grid, the body indent and the
     intro indent, so the index / figure / event / paragraph all land on the
     same x down the whole section. */
  .achievements {
    --col-index: 4.5rem;
    --col-figure: 9rem;
    --col-gap: 2rem;
    --content-indent: calc(var(--col-index) + var(--col-figure) + var(--col-gap) * 2);
    --head-h: 6.5rem;
  }

  @media (min-width: 860px) {
    .achievements {
      --head-h: 7rem;
    }
  }

  .achievements-intro {
    padding-block: clamp(3.5rem, 13vh, 8rem) clamp(2rem, 7vh, 4rem);
  }

  .achievements-intro :global(.achievements-title) {
    font-size: clamp(2.5rem, 9vw, 6.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.035em;
    line-height: 0.92;
    margin: 0;
  }

  .intro-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: clamp(1.75rem, 5vh, 3rem);
  }

  @media (min-width: 860px) {
    .intro-row {
      padding-left: var(--content-indent);
    }
  }

  .intro-row :global(.achievements-lede) {
    margin: 0;
    max-width: 44ch;
    color: var(--color-muted);
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack-item {
    position: sticky;
    top: calc(var(--i) * var(--head-h));
  }

  .ach {
    /* Each panel fills the viewport *below* the heads already stacked above
       it, so no panel's content is pushed under the fold. */
    min-height: calc(100svh - var(--i) * var(--head-h));
    display: flex;
    flex-direction: column;
    /* Opaque ground is what makes the occlusion read — without it the panel
       below would show through as this one scrolls over it. */
    background: var(--color-ground);
    border-top: 1px solid var(--color-rule);
    padding-inline: var(--gutter);
  }

  .ach-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 84rem;
    margin-inline: auto;
  }

  .ach-head {
    height: var(--head-h);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    grid-template-areas:
      "index figure year arrow"
      "event event event event";
    align-items: center;
    gap: 0.25rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 860px) {
    .ach-head {
      grid-template-columns: var(--col-index) var(--col-figure) minmax(0, 1fr) auto auto;
      grid-template-areas: "index figure event year arrow";
      gap: var(--col-gap);
    }
  }

  .ach-index {
    grid-area: index;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ach-figure {
    grid-area: figure;
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .ach-event {
    grid-area: event;
    /* Sized to keep the longest event name on one line inside a fixed-height
       head — the head height is what the sticky offsets are computed from, so
       it must not grow. */
    font-size: clamp(1.35rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .ach-year {
    grid-area: year;
    justify-self: end;
  }

  .ach-arrow {
    grid-area: arrow;
    justify-self: end;
    font-size: 1.25rem;
    color: var(--color-accent);
  }

  /* Top-aligned, not centred in the panel: the paragraph has to read as
     belonging to the head directly above it. The space left below is the
     region the next panel scrolls over first, so it is never dead for long. */
  .ach-body {
    padding-block: clamp(2rem, 8vh, 4.5rem) clamp(2rem, 6vh, 3.5rem);
  }

  @media (min-width: 860px) {
    /* Line the paragraph up under the event name, not under the index. */
    .ach-body {
      padding-left: var(--content-indent);
    }
  }

  .ach-detail {
    color: var(--color-accent);
    margin: 0 0 1.25rem;
  }

  .ach-blurb {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.125rem, 1.6vw, 1.625rem);
    line-height: 1.45;
    color: var(--color-muted);
  }

  /* ── S3 work ─────────────────────────────────────────────────── */
  .work-section {
    padding-block: clamp(3rem, 10vh, 6rem);
  }

  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  .project-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vh, 2.25rem);
    border-top: 1px solid var(--color-rule);
    color: inherit;
  }

  .project-row .idx {
    flex-shrink: 0;
    width: 2rem;
  }

  .project-rows li:last-child .project-row {
    border-bottom: 1px solid var(--color-rule);
  }

  .project-title {
    font-size: var(--text-project);
    font-weight: 500;
    transition: transform 400ms ease;
  }

  .project-row-meta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .project-view {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .project-thumb {
    position: absolute;
    left: 4.5rem;
    width: 8rem;
    aspect-ratio: 16 / 9;
    opacity: 0;
    transform: scale(0.92);
    transition: opacity 350ms ease, transform 350ms ease;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-row:hover .project-thumb,
    .project-row:focus-visible .project-thumb {
      opacity: 1;
      transform: scale(1);
    }
    .project-row:hover .project-title,
    .project-row:focus-visible .project-title {
      transform: translateX(9.5rem);
    }
    .project-row:hover .project-view,
    .project-row:focus-visible .project-view {
      opacity: 1;
    }
  }

  .all-work {
    display: inline-block;
    margin-top: clamp(2rem, 5vh, 3rem);
  }

  /* ── S4 about ────────────────────────────────────────────────── */
  .about-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .about-grid {
      grid-template-columns: auto 1fr;
      gap: 3.5rem;
    }
  }

  .about-portrait {
    width: 9rem;
    aspect-ratio: 1 / 1;
  }

  .about-portrait img {
    object-fit: cover;
  }

  .about-copy :global(.about-kicker) {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .about-copy :global(.about-name) {
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.98;
    margin: 0;
  }

  .about-copy :global(.about-statement) {
    margin: 1.25rem 0 0;
    max-width: 42ch;
    color: var(--color-muted);
  }

  .about-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .tag {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.25rem;
  }

  /* ── S5 capabilities marquee ─────────────────────────────────── */
  .capabilities-section {
    border-block: 1px solid var(--color-rule);
    padding-block: clamp(2rem, 6vh, 3rem);
    overflow: hidden;
    display: grid;
    gap: 1.25rem;
  }

  .marquee-row {
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    gap: 2.5rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-left {
      animation: marquee-left 40s linear infinite;
    }
    .marquee-right {
      animation: marquee-right 40s linear infinite;
    }
  }

  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes marquee-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  /* ── S6 outro ────────────────────────────────────────────────── */
  .outro {
    align-items: stretch;
  }

  .outro-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4vh, 2.5rem);
    padding-block: clamp(3rem, 10vh, 5rem);
    min-height: 100%;
  }

  .outro :global(.outro-line) {
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.98;
    margin: 0;
  }

  .outro-email {
    display: inline-block;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 2rem);
    background-image: linear-gradient(var(--color-muted), var(--color-muted));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 0.2em;
    transition: background-size 200ms ease, background-image 200ms ease, color 200ms ease;
  }

  .outro-email:hover,
  .outro-email:focus-visible {
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 100% 2px;
    color: var(--color-accent);
  }

  .outro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .outro-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    border-top: 1px solid var(--color-rule);
    padding-top: 1.5rem;
    margin-top: clamp(2rem, 6vh, 3rem);
  }
</style>
