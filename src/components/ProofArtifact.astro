---
/**
 * Proof artifact — spine step IV, and the reason this folio beats a designer's.
 * A first-class component, not an afterthought.
 *
 * Three kinds, one contract:
 *   tests — real runner output, monospace, unedited
 *   diff  — a real patch the tool generated, +/- coloured
 *   video — a recorded run, poster-first, preload="none", zero JS
 *
 * The body is read from src/proof/<file> at build time. Drop the file in and it
 * renders; leave it out and you get a labelled frame naming the exact path.
 */
import { assets, ratio } from '../config/assets';

interface Props {
  kind: 'tests' | 'diff' | 'video';
  summary: string;
  caption?: string;
  /** Path under src/proof/, e.g. "arc/tests.txt" */
  file?: string;
  /** Case-study slug; supplies the video and poster paths. */
  slug: string;
}
const { kind, summary, caption, file, slug } = Astro.props;

const raw = import.meta.glob('/src/proof/**/*.txt', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const body = file ? raw[`/src/proof/${file}`] : undefined;
const media = assets.project(slug);

const lines = body ? body.replace(/\s+$/, '').split('\n') : [];
const diffClass = (l: string) =>
  l.startsWith('+++') || l.startsWith('---') || l.startsWith('@@')
    ? 'hunk'
    : l.startsWith('+')
      ? 'add'
      : l.startsWith('-')
        ? 'del'
        : '';

const missingLabel =
  kind === 'video'
    ? `drop in public${media.demo}`
    : `drop in src/proof/${file ?? `${slug}/${kind}.txt`}`;
---

<figure class="proof">
  <p class="summary">
    <span class="figure">{summary}</span>
    <span class="meta kind">{kind === 'tests' ? 'test run' : kind === 'diff' ? 'generated patch' : 'recorded run'}</span>
  </p>

  {
    kind === 'video' ? (
      <div class="frame" style={`aspect-ratio: ${ratio.media}`}>
        <video controls preload="none" poster={media.shot1} playsinline>
          <source src={media.demo} type="video/mp4" />
          Your browser cannot play this video.
          <a href={media.demo}>Download the recording</a>.
        </video>
      </div>
    ) : body ? (
      <div class="well" data-kind={kind}>
        <pre><code>{lines.map((l) => (
          kind === 'diff'
            ? <span class:list={['line', diffClass(l)]}>{l + '\n'}</span>
            : l + '\n'
        ))}</code></pre>
      </div>
    ) : (
      <div class="pending">
        <span class="meta">{missingLabel}</span>
      </div>
    )
  }

  {caption && <figcaption class="meta">{caption}</figcaption>}
</figure>

<style>
  .proof { margin: 0; }

  .summary {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 1.25rem;
  }
  .figure {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .kind { color: var(--color-ink-soft); }

  .well {
    border: 1px solid var(--color-rule);
    background: var(--color-paper-deep);
    overflow-x: auto;
  }
  pre {
    margin: 0;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    tab-size: 2;
  }
  code { font: inherit; }

  .line { display: inline-block; width: 100%; }
  .add { color: #14532d; background: rgba(20, 83, 45, 0.07); }
  .del { color: #7f1d1d; background: rgba(127, 29, 29, 0.07); }
  .hunk { color: var(--color-mark); }

  .pending {
    border: 1px dashed var(--color-ink-soft);
    background: var(--color-paper-deep);
    min-height: 9rem;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
  }

  figcaption { margin-top: 0.9rem; max-width: var(--measure); }
</style>
