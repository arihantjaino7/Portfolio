---
/**
 * The card a project row opens.
 *
 * One <dialog> per project, all of them rendered server-side; the script only
 * calls showModal() and feeds the tilt two custom properties. Everything the
 * card says is frontmatter, so adding a fourth project adds a fourth card.
 *
 * Progressive enhancement, in the same shape the rest of the page uses:
 *   - The row stays a real <a href="/work/<slug>">. With JS off the click is
 *     never intercepted and the case study page loads, which is the honest
 *     fallback — the card is a preview of that page, not a replacement for it.
 *   - <dialog>.showModal() supplies the focus trap, the Esc handler, the inert
 *     background and ::backdrop for free. None of that is hand-rolled here.
 *   - The tilt is decoration. Without it the card is a still card, correctly
 *     laid out, and under prefers-reduced-motion that is what everyone gets.
 */
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../config/paths';

interface Props {
  projects: CollectionEntry<'work'>[];
}
const { projects } = Astro.props;
---

{
  projects.map((p) => {
    const d = p.data;
    return (
      <dialog class="pc" id={`pc-${p.id}`} aria-labelledby={`pc-t-${p.id}`}>
        {/* The tilting element is inside the dialog rather than the dialog
            itself: a transformed <dialog> in the top layer drags its
            ::backdrop's coordinate space around with it. */}
        <div class="pc-card" data-pc-card>
          <div class="pc-glow" aria-hidden="true" />

          <div class="pc-body">
            <p class="pc-meta meta">
              {d.year}
              {d.category && <span class="pc-sep">—</span>}
              {d.category}
            </p>

            <h2 class="pc-title" id={`pc-t-${p.id}`}>
              {d.title}
            </h2>

            <p class="pc-blurb">{d.blurb ?? d.summary}</p>

            <div class="pc-links">
              <a class="pc-go pc-go-lead" href={withBase(`/work/${p.id}`)}>
                <span>Full case study</span>
                <span class="pc-arrow" aria-hidden="true">
                  →
                </span>
              </a>

              {d.links.repo && (
                <a class="pc-go" href={d.links.repo} rel="noopener">
                  <span>GitHub</span>
                  <span class="pc-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              )}

              {d.links.live && (
                <a class="pc-go" href={d.links.live} rel="noopener">
                  <span>Live</span>
                  <span class="pc-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              )}

              {!d.links.repo && !d.links.live && (
                <p class="pc-none meta">No public repository yet</p>
              )}
            </div>
          </div>

          <button type="button" class="pc-close" data-pc-close aria-label="Close">
            <span aria-hidden="true">✕</span>
          </button>
        </div>
      </dialog>
    );
  })
}

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // A tilt is meaningless without a real pointer, and on touch it would fire
  // on every tap-scroll.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

  const MAX_TILT = 7; // degrees on each axis at the far corner

  /** Wire one card's lean and its light. */
  function wireTilt(card: HTMLElement) {
    let raf = 0;
    let pending: { x: number; y: number } | null = null;

    function apply() {
      raf = 0;
      if (!pending) return;
      const { x, y } = pending;
      // -0.5..0.5 from the card's centre. rotateX is negated: pushing the
      // pointer down should tip the top of the card away, not toward you.
      card.style.setProperty('--ry', `${x * 2 * MAX_TILT}deg`);
      card.style.setProperty('--rx', `${-y * 2 * MAX_TILT}deg`);
      card.style.setProperty('--mx', `${(x + 0.5) * 100}%`);
      card.style.setProperty('--my', `${(y + 0.5) * 100}%`);
    }

    card.addEventListener('pointermove', (e) => {
      if (!fine.matches || reduce.matches) return;
      const r = card.getBoundingClientRect();
      pending = { x: (e.clientX - r.left) / r.width - 0.5, y: (e.clientY - r.top) / r.height - 0.5 };
      // Coalesced to a frame: pointermove fires well above frame rate and
      // every handler here writes a style, which would otherwise queue a
      // style recalc per event.
      if (!raf) raf = requestAnimationFrame(apply);
    });

    card.addEventListener('pointerenter', () => {
      if (!fine.matches || reduce.matches) return;
      card.classList.add('is-live');
    });

    // Settles flat. The transform transition carries it back, so there is
    // nothing to animate by hand.
    function rest() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      pending = null;
      card.classList.remove('is-live');
      card.style.removeProperty('--rx');
      card.style.removeProperty('--ry');
    }
    card.addEventListener('pointerleave', rest);
    return rest;
  }

  document.querySelectorAll<HTMLDialogElement>('dialog.pc').forEach((dialog) => {
    const card = dialog.querySelector<HTMLElement>('[data-pc-card]');
    const rest = card ? wireTilt(card) : () => {};

    dialog
      .querySelector<HTMLButtonElement>('[data-pc-close]')
      ?.addEventListener('click', () => dialog.close());

    // Click outside the card closes it. The dialog element fills the viewport
    // for hit-testing purposes even though only the card is painted, so the
    // test is "did this land on the card", not "did this land on the dialog".
    dialog.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      if (!e.target.closest('[data-pc-card]')) dialog.close();
    });

    // Esc is handled by the dialog itself; this only unwinds the tilt so the
    // card is flat again the next time it opens.
    dialog.addEventListener('close', rest);
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-card]').forEach((row) => {
    row.addEventListener('click', (e) => {
      // Let a modified click do what the person asked: open the case study in
      // a new tab. Only a plain left click becomes a card.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      const dialog = document.getElementById(`pc-${row.dataset.card}`);
      if (!(dialog instanceof HTMLDialogElement)) return;
      e.preventDefault();
      dialog.showModal();
    });
  });
</script>

<style>
  /* ── shell ───────────────────────────────────────────────────── */
  .pc {
    /* The dark palette, declared rather than inherited. The card is always a
       dark object, and it should not change if the section that hosts it ever
       stops being a .dark-panel. */
    --color-ground: #0b0c0e;
    --color-ground-deep: #16181c;
    --color-text: #f2f1ed;
    --color-muted: rgba(242, 241, 237, 0.62);
    --color-rule: rgba(242, 241, 237, 0.14);
    --color-accent: #b8734d;
    color-scheme: dark;

    width: min(32rem, 100vw - 2rem);
    max-width: none;
    /* Explicit, not inherited: a modal <dialog> is centred by the UA's
       `margin: auto`, and Tailwind's preflight zeroes every element's margin —
       without this the card pins itself to the top-left corner. */
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    overflow: visible;
  }

  .pc::backdrop {
    background: rgba(8, 9, 11, 0.7);
    backdrop-filter: blur(10px) saturate(0.9);
  }

  /* ── the card ────────────────────────────────────────────────── */
  .pc-card {
    position: relative;
    border-radius: 1.25rem;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(242, 241, 237, 0.05), transparent 62%),
      var(--color-ground-deep);
    border: 1px solid var(--color-rule);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    /* preserve-3d rather than a flat transform, so the contents can stand off
       the face in z and parallax as the card leans. Deliberately no
       overflow: hidden — it forces flattening and the whole thing goes flat. */
    transform-style: preserve-3d;
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    /* One transition for both the tracking and the settle. It lags the pointer
       by a frame or two, which is the whole feel — a card with weight rather
       than one glued to the cursor. */
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.5),
      0 24px 70px rgba(0, 0, 0, 0.55);
  }

  /* The light that follows the pointer across the face. */
  .pc-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      22rem 22rem at var(--mx, 50%) var(--my, 50%),
      rgba(242, 241, 237, 0.09),
      transparent 68%
    );
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  /* The same light again, clipped to the border. Two masks composited to
     exclude gives a 1px ring — a gradient border, without a second element
     under the card to bleed out from behind it. */
  .pc-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      16rem 16rem at var(--mx, 50%) var(--my, 50%),
      rgba(242, 241, 237, 0.5),
      transparent 60%
    );
    -webkit-mask:
      linear-gradient(#000, #000) content-box,
      linear-gradient(#000, #000);
    mask:
      linear-gradient(#000, #000) content-box,
      linear-gradient(#000, #000);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .pc-card.is-live .pc-glow,
  .pc-card.is-live::after {
    opacity: 1;
  }

  /* Stood off the face so it parallaxes against the card as it leans. */
  .pc-body {
    position: relative;
    transform: translateZ(38px);
  }

  .pc-meta {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pc-sep {
    margin: 0 0.5rem;
    color: var(--color-accent);
  }

  .pc-title {
    font-family: var(--font-compress);
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.95;
    margin: 0 0 1.25rem;
  }

  .pc-blurb {
    margin: 0 0 2rem;
    /* No measure cap: the card is already 32rem wide and its padding leaves
       about 47 characters, which is inside the comfortable range. Capping at
       34ch on top of that just left a column of dead card to the right. */
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .pc-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .pc-go {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted);
    transition: color 200ms ease;
  }

  .pc-go-lead {
    color: var(--color-text);
  }

  .pc-arrow {
    display: inline-block;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-go:hover,
  .pc-go:focus-visible {
    color: var(--color-accent);
  }

  .pc-go:hover .pc-arrow,
  .pc-go:focus-visible .pc-arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  /* The lead link's arrow travels along its own line rather than diagonally —
     it goes to a page on this site, not off it. */
  .pc-go-lead:hover .pc-arrow,
  .pc-go-lead:focus-visible .pc-arrow {
    transform: translateX(0.3rem);
  }

  .pc-none {
    margin: 0;
    color: var(--color-muted);
  }

  .pc-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    transform: translateZ(38px);
    transition: color 200ms ease, background 200ms ease;
  }

  .pc-close:hover,
  .pc-close:focus-visible {
    color: var(--color-text);
    background: rgba(242, 241, 237, 0.08);
  }

  /* Nothing leans, nothing lights up, and the card opens flat. */
  @media (prefers-reduced-motion: reduce) {
    .pc-card {
      transform: none;
      transition: none;
    }
    .pc-body,
    .pc-close {
      transform: none;
    }
  }
</style>
