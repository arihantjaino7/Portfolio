  "narrative": {
    "northStar": "Woodland workshop",
    "overview": "The Woodland workshop is a small inhabited pixel world: dark pine surrounds, amber treasure, square inventory surfaces, and original procedural scenery. Crisp game lettering identifies places and actions; a quiet sans-serif keeps real project descriptions readable.\n\nThis system governs the homepage and its inventory, direct-reading fallback, and controls. It is extracted from the finished build, not an approved static comp. Existing /work, /work/[slug], /about, and /404 documents retain Base.astro and global.css; their earlier design record is preserved in docs/legacy-design.md. Do not treat this homepage system as an automatic migration of those routes.",
    "keyCharacteristics": [
      "Original code-native pixel scenery and authored SVG icons.",
      "Square layered forest surfaces with warm interaction accents.",
      "Readable HTML inventory beside keyboard, pointer, and touch exploration."
    ],
    "rules": [
      {
        "name": "The Warm Signal Rule",
        "body": "Gold connects primary actions, focus, the chest, and selected inventory items; mint marks availability and visited progress.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Pixelify Sans names the world and its actions; Manrope carries project summaries and explanatory prose.",
        "section": "typography"
      },
      {
        "name": "The Material Edge Rule",
        "body": "Use square borders and lighter top edges to suggest inventory material; the world can retain its soft ambient light and shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use authored crisp SVG icons and pixelated canvas rendering.",
      "Do preserve visible gold focus and immediate HTML access to real portfolio content.",
      "Do keep project descriptions in Manrope with a comfortable reading measure.",
      "Do carry selected, visited, disabled, and pressed states through their existing color and edge treatments."
    ],
    "donts": [
      "Don't substitute copied game textures or sprites for original artwork.",
      "Don't require walking skill to reach the portfolio sections.",
      "Don't inherit legacy route styles into the homepage without an explicit reconciliation."
    ]
  }
}
