---
/**
 * The chapter rail — the site's one bold element. See DESIGN.md §4.
 *
 * Not a big number in a corner. A drafting-sheet annotation block: outlined
 * numeral, a hairline running the height of the section, and a readout of what
 * the chapter contains. Zero JavaScript; `position: sticky` does all of it.
 * Phase 2 swaps sticky for a GSAP pin without changing this markup.
 */
interface Props {
  numeral: string;
  title: string;
  /** What the chapter holds: "3 entries", "4 areas". Not decoration. */
  readout: string;
  id: string;
  /** Suppresses the <h2>; used where the body supplies its own heading. */
  bare?: boolean;
}
const { numeral, title, readout, id, bare = false } = Astro.props;
---

<section id={id} class="chapter" aria-labelledby={`${id}-title`}>
  <div class="shell grid-rail">
    <div class="rail">
      <div class="rail-sticky">
        <span class="numeral" aria-hidden="true">{numeral}</span>
        <span class="rail-line" aria-hidden="true"></span>
        <span class="meta readout">{readout}</span>
      </div>
    </div>

    <div class="rail-body">
      <h2 id={`${id}-title`} class="chapter-title" class:list={[{ 'sr-only': bare }]}>
        <span class="meta chapter-eyebrow">chapter {numeral.toLowerCase()}</span>
        {title}
      </h2>
      <slot />
    </div>
  </div>
</section>

<style>
  .chapter {
    padding-block: var(--spacing-chapter);
    border-top: 1px solid var(--color-rule);
  }

  .chapter-eyebrow {
    display: block;
    margin-bottom: 0.85rem;
    /* lowercase, normal tracking — never tracked-out caps. DESIGN.md §3 */
  }

  .chapter-title {
    font-size: var(--text-chapter);
    margin-bottom: 2.5rem;
  }

  .numeral {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 500;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-ink);
    letter-spacing: -0.04em;
    display: block;
  }

  .readout {
    display: block;
    color: var(--color-ink-soft);
  }

  /* Small screens: the rail unfolds into a band above the chapter. */
  .rail {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .rail-sticky {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
  }
  .rail .numeral {
    font-size: 2rem;
    -webkit-text-stroke-width: 1px;
  }
  .rail-line { display: none; }
  .rail .readout { margin-left: auto; }

  @media (min-width: 900px) {
    .rail {
      display: block;
      padding-bottom: 0;
      border-bottom: 0;
      border-left: 1px solid var(--color-rule);
      padding-left: clamp(1rem, 2vw, 1.75rem);
      margin-left: -1px;
    }
    .rail-sticky {
      display: block;
      position: sticky;
      top: clamp(3rem, 12vh, 7rem);
    }
    .rail .numeral {
      font-size: clamp(3rem, 7vw, 5.5rem);
      -webkit-text-stroke-width: 1.5px;
    }
    .rail-line {
      display: block;
      width: 1px;
      height: clamp(3rem, 9vh, 7rem);
      background: var(--color-rule);
      margin: 1.25rem 0 1.25rem 0.15rem;
    }
    .rail .readout { margin-left: 0; }
  }

  /* Browsers without -webkit-text-stroke get a filled numeral, not an invisible one. */
  @supports not (-webkit-text-stroke: 1px black) {
    .numeral { color: var(--color-ink); }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
