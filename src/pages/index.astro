---
/**
 * Phase 1 — foundation shell. REDESIGN.md §1, §2 Phase 1.
 *
 * Six empty full-height sections in the final page order. No section content
 * lands until its own phase (2-6); this phase only proves the motion engine
 * is wired: Lenis + GSAP ScrollTrigger initialise, and the one test element
 * below mask-reveals on load.
 */
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import { assets } from '../config/assets';
---

<Base ogImage={assets.og('default')}>
  <!--
    Armed before first paint. Kept from the previous build: later phases that
    need a load-only entrance (not a scroll-triggered one) key off this class
    the same way the old hero did, without waiting on the motion bundle.
  -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion-pending');
    }
  </script>

  <section id="landing" class="screen">
    <div class="shell">
      <Reveal as="p" class="engine-check">Motion engine online.</Reveal>
    </div>
  </section>

  <section id="achievements" class="screen"></section>
  <section id="work" class="screen"></section>
  <section id="about" class="screen"></section>
  <section id="capabilities" class="screen"></section>
  <section id="outro" class="screen"></section>

  <!-- Home only — every other route stays at zero client JS. -->
  <script>
    import '../scripts/motion';
  </script>
</Base>

<style>
  .screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .engine-check {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-muted);
    margin: 0;
  }
</style>
