---
import { person, nav, links } from '../config/site';
import { withBase } from '../config/paths';
const path = Astro.url.pathname;
// The site deploys under /Portfolio, so home is that base with no trailing
// slash — never bare '/'. Same BASE_URL normalization as paths.ts.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = path.replace(/\/$/, '') === base;

const items = [...nav, { href: links.email, label: 'email' }];
---

<!--
  `header-over-hero` is rendered on rather than added by script: the homepage
  opens with the bar already sitting on top of the dark landing card, and
  adding the class on first tick would flash a cream strip across the top of
  it. The script below only ever takes it away, once the hero is behind you.
-->
<header class:list={['site-header', isHome && 'header-over-hero']}>
  <div class="shell header-inner">
    {
      isHome ? (
        <span class="brand">{person.name.toLowerCase()}</span>
      ) : (
        <a href={withBase('/')} class="brand brand-link">{person.name.toLowerCase()}</a>
      )
    }
    <nav aria-label="Primary" class="header-nav">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="nav-pill"
            aria-current={
              item.href.startsWith('mailto:') || !path.startsWith(item.href) ? undefined : 'page'
            }
          >
            <span class="nav-pill-label">{item.label}</span>
          </a>
        ))
      }
    </nav>
  </div>
</header>

<!--
  Upgrade only: the fill already expands from the pill's centre with no JS at
  all (--px/--py fall back to 50%). This just moves the origin to wherever the
  pointer actually crossed the edge, and on the way out to wherever it left, so
  the circle grows and retreats from the cursor rather than the middle.
  is:inline keeps it out of the bundle — every route but the homepage still
  ships zero fetched JS.
-->
<script is:inline>
  (function () {
    var pills = document.querySelectorAll('.nav-pill');
    for (var i = 0; i < pills.length; i++) {
      (function (el) {
        function origin(e) {
          var r = el.getBoundingClientRect();
          el.style.setProperty('--px', e.clientX - r.left + 'px');
          el.style.setProperty('--py', e.clientY - r.top + 'px');
        }
        el.addEventListener('pointerenter', origin);
        el.addEventListener('pointerleave', origin);
      })(pills[i]);
    }
  })();
</script>

<!--
  Hide on scroll down, show on scroll up — except over the landing hero
  (#landing, homepage only), where it always stays visible regardless of
  direction. Upgrade only: the header is position: sticky in the CSS below
  with no hidden state by default, so with this script absent (or under
  reduced motion, which it's gated behind) it just stays pinned and visible,
  which was already the correct, tested fallback before this existed.

  Plain scroll listener rather than routing through motion.ts: that bundle is
  homepage-only and GSAP/ScrollTrigger would be a lot of dependency for a
  same-frame threshold comparison every other route doesn't need. is:inline
  keeps this out of the bundle the same way the pill script above is.
-->
<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    // Reduced motion suppresses the hide-on-scroll only. The dark-over-hero
    // flip below is not motion — it is which palette the bar is painted in,
    // and skipping it would strand the homepage header black all the way
    // down the page.
    var allowHide = !matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Absolute document position of the hero's own bottom edge, measured
    // once and cached: comparing it to scrollY every tick is what lets
    // "always visible over the landing" work without re-querying layout on
    // each scroll event. Measured lazily rather than synchronously here:
    // this script tag sits inside <header>, which the browser parses and
    // runs *before* <main> — so #landing doesn't exist in the DOM yet at this
    // point, and measuring eagerly would silently cache 0 forever. On routes
    // with no #landing at all, this correctly settles on 0 — the header
    // simply becomes eligible to hide from the top of the page, which is the
    // right default for a page with no hero to stay pinned over.
    var heroBottom = 0;
    function measureHero() {
      var hero = document.getElementById('landing');
      heroBottom = hero ? hero.getBoundingClientRect().bottom + window.scrollY : 0;
    }
    measureHero();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', measureHero);
    }
    addEventListener('resize', measureHero);

    var lastY = window.scrollY;
    var hidden = false;
    var overHero = header.classList.contains('header-over-hero');
    // Scroll noise (trackpad micro-deltas, rubber-banding) shouldn't flip the
    // header on every tick — only a deliberate few px of travel should.
    var THRESHOLD = 6;
    var ticking = false;

    function apply() {
      ticking = false;
      var y = Math.max(0, window.scrollY);
      var delta = y - lastY;

      var shouldHide = hidden;
      if (!allowHide) {
        shouldHide = false;
      } else if (y <= heroBottom) {
        shouldHide = false;
      } else if (delta > THRESHOLD) {
        shouldHide = true;
      } else if (delta < -THRESHOLD) {
        shouldHide = false;
      }

      if (shouldHide !== hidden) {
        hidden = shouldHide;
        header.classList.toggle('header-hidden', hidden);
      }

      // Dark while the bar is over the landing card, light everywhere else.
      // Same heroBottom the pin above reads, so the two can never disagree
      // about where the hero ends. On a route with no #landing heroBottom is
      // 0 and this is false from the first tick, which is correct — those
      // pages never carry the class in the first place.
      var over = y <= heroBottom;
      if (over !== overHero) {
        overHero = over;
        header.classList.toggle('header-over-hero', over);
      }

      lastY = y;
    }

    addEventListener(
      'scroll',
      function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  })();
</script>

<style>
  /* Every colour here reads a live token (--color-text / --color-ground /
     --color-rule) rather than the --color-ink family: Tailwind's @theme bakes
     those aliases to a static value, so they would not follow a .dark-panel
     override if the header ever sits over one. */
  /* Pinned so scroll snapping can't carry it off-screen: a snapped section's
     top lands flush with the viewport top, and the header sits above that
     section in normal flow, so without this it scrolls fully out of view the
     instant any snap fires — including on load. The header sits outside every
     .dark-panel wrapper, so var(--color-ground) here resolves to the light
     value unless the bar declares otherwise itself — which is exactly what
     .header-over-hero below does. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-ground);
    border-bottom: 1px solid var(--color-rule);
    transition: transform 320ms ease;
  }

  /* Over the landing card the bar joins it: the same five tokens .dark-panel
     redeclares, scoped to the header, so the wordmark, the pills and their
     hover fill all invert with no per-element rules. The rule under it goes
     too — a hairline across a continuous black field only marks the seam. */
  .site-header.header-over-hero {
    --color-ground: #0b0c0e;
    --color-ground-deep: #16181c;
    --color-text: #f2f1ed;
    --color-muted: rgba(242, 241, 237, 0.62);
    --color-rule: rgba(242, 241, 237, 0.14);
    color-scheme: dark;
    border-bottom-color: transparent;
  }

  /* Slid up by its own height rather than the viewport's: translateY(-100%)
     is relative to the element's own box, so this holds exactly regardless
     of the responsive height change at the 34rem breakpoint below. */
  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .brand-link:hover,
  .brand-link:focus-visible {
    color: var(--color-accent);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-pill {
    position: relative;
    /* Clips the expanding circle to the pill's rounded shape. */
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    /* No border at rest — the pill only becomes visible as the fill arrives.
       The 1px the border used to occupy moves into the padding so the box
       keeps its size, and so `overflow` clips the fill to the full box rather
       than leaving a hairline of page showing around it. */
    padding: calc(0.7rem + 1px) calc(1.3rem + 1px);
    border-radius: 0.25rem;
    background: transparent;
    line-height: 1;
  }

  /* The fill. A circle centred on the pointer's entry point, scaled up to
     flood the pill. 260% of the pill's width, kept square by aspect-ratio, is
     wide enough that the circle still covers the far corner when it starts
     from the opposite one. */
  .nav-pill::before {
    content: '';
    position: absolute;
    left: var(--px, 50%);
    top: var(--py, 50%);
    width: 260%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--color-text);
    transform: scale(0);
    /* Near-linear through the middle rather than a hard ease-out: the circle
       is oversized, so a front-loaded curve has it covering the pill within
       ~70ms and the sweep never reads. */
    transition: transform 560ms cubic-bezier(0.62, 0.04, 0.3, 1);
  }

  .nav-pill-label {
    position: relative; /* above the fill */
    /* Matched to .brand exactly — same family, size, weight and tracking — so
       the nav reads as the same voice as the wordmark across the bar. */
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    /* Held back a beat so the letters flip once the fill has arrived under
       them, rather than greying out while it is still travelling. */
    transition: color 180ms ease 200ms;
  }

  /* Drawn as a pseudo-element rather than the background-image underline the
     old header links used: that needs padding-bottom to clear the text, which
     would push the label off-centre inside the pill. */
  .nav-pill-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.32em;
    height: 1px;
    background: var(--color-rule);
    transition: background 180ms ease 200ms;
  }

  .nav-pill:hover .nav-pill-label::after,
  .nav-pill:focus-visible .nav-pill-label::after,
  .nav-pill[aria-current='page'] .nav-pill-label::after {
    background: var(--color-ground);
  }

  .nav-pill[aria-current='page'] .nav-pill-label::after {
    transition: none;
  }

  .nav-pill:hover::before,
  .nav-pill:focus-visible::before,
  .nav-pill[aria-current='page']::before {
    transform: scale(1);
  }

  .nav-pill:hover .nav-pill-label,
  .nav-pill:focus-visible .nav-pill-label,
  .nav-pill[aria-current='page'] .nav-pill-label {
    color: var(--color-ground);
  }

  /* The current page is already filled, so it has no travel to do. */
  .nav-pill[aria-current='page']::before {
    transition: none;
  }

  .nav-pill[aria-current='page'] .nav-pill-label {
    transition: none;
  }

  @media (max-width: 34rem) {
    .header-inner {
      gap: 0.75rem;
    }
    .header-nav {
      gap: 0.2rem;
    }
    .nav-pill {
      padding: 0.55rem 0.7rem;
    }
    .nav-pill-label {
      font-size: 0.8125rem;
    }
    .brand {
      font-size: 0.8125rem;
    }
  }
</style>
