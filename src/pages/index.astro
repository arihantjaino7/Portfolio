---
import { getCollection } from 'astro:content';
import { person, links, skills, achievements, meta } from '../config/site';
import { withBase } from '../config/paths';
import PixelIcon from '../components/PixelIcon.astro';
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/500.css';
import '@fontsource/pixelify-sans/600.css';
import '../styles/world.css';
const projects = (await getCollection('work', ({data}) => !data.draft)).sort((a,b) => a.data.order-b.data.order);
const destinations = [
  { id:'about', name:'About', icon:'book', place:'The campsite' },
  { id:'projects', name:'Projects', icon:'chest', place:'The project vault' },
  { id:'skills', name:'Skills', icon:'pickaxe', place:'The workshop' },
  { id:'achievements', name:'Milestones', icon:'trophy', place:'The monument' },
  { id:'contact', name:'Contact', icon:'mail', place:'The post office' },
];
const projectIcons = ['gem','shield','branch'];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Arihant Jain — A world of things I build</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#152b25" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/world-favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content="Arihant Jain — A world of things I build" />
    <meta property="og:description" content="Explore a little pixel world. Open a chest. Discover real engineering work." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/assets/og/default.png'),Astro.site)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style is:inline set:html={`@font-face{font-family:Manrope;src:url('${withBase('/fonts/manrope-latin-wght-normal.woff2')}') format('woff2');font-weight:200 800;font-display:swap;}`} />
  </head>
  <body>
    <a class="skip-link" href="#direct-portfolio">Skip the game and read the portfolio</a>
    <main id="world" aria-label="Arihant's playable portfolio">
      <canvas id="game" tabindex="0" aria-label="Pixel forest world. Use WASD or arrow keys to move, E to interact, and 1 through 5 to open portfolio sections." aria-describedby="game-instructions"></canvas>
      <div class="world-vignette" aria-hidden="true"></div>
      <header class="world-header">
        <a class="identity" href={withBase('/')} aria-label="Arihant Jain home">
          <span class="identity-block" aria-hidden="true"><span>aj</span></span>
          <span><strong>Arihant Jain</strong><small>developer & world builder</small></span>
        </a>
        <div class="header-actions">
          <a class="plain-link browse-link" href={withBase('/work')}>Browse portfolio <span aria-hidden="true">↗</span></a>
          <span class="header-divider"></span>
          <button class="icon-button" id="sound-toggle" aria-label="Enable sound effects" aria-pressed="false"><PixelIcon name="sound" /><span class="muted-slash" aria-hidden="true"></span></button>
          <button class="icon-button" id="time-toggle" aria-label="Switch to night" aria-pressed="false"><PixelIcon name="moon" /></button>
          <button class="icon-button" data-open="help" aria-label="How to play"><PixelIcon name="help" /></button>
        </div>
      </header>
      <section class="welcome" aria-labelledby="welcome-title">
        <h1 id="welcome-title">A little world.<br/>A lot to <span>build.</span></h1>
        <p>Hey, I’m Arihant. I build AI systems,<br class="desktop-break"/> security tools, and full-stack products.<br class="desktop-break"/> Come have a look around.</p>
        <div class="welcome-actions">
          <button class="pixel-button primary" id="start-exploring">Let’s explore <PixelIcon name="arrow" /></button>
          <button class="text-button" data-open="projects">Just show me the projects</button>
        </div>
        <span class="welcome-note"><span class="status-dot"></span> An interactive portfolio, made to be explored.</span>
      </section>
      <aside class="mini-map" aria-label="World map">
        <div class="map-heading"><PixelIcon name="map" /><span>The builder’s grove</span><span class="map-north">N ↑</span></div>
        <div class="map-art" aria-hidden="true"><span class="map-river"></span><span class="map-path path-h"></span><span class="map-path path-v"></span><span class="map-player" id="map-player"></span></div>
        {destinations.map((d) => <button class={`map-node node-${d.id}`} data-travel={d.id} aria-label={`Walk to ${d.name}: ${d.place}`} title={d.place}><PixelIcon name={d.icon}/></button>)}
        <span class="map-caption">Click a landmark to travel</span>
      </aside>
      <div class="quest" id="quest"><span class="quest-mark" aria-hidden="true"><PixelIcon name="chest"/></span><div><strong id="quest-title">Every project starts with curiosity.</strong><span id="quest-copy">Find the golden chest to discover my work.</span></div><span class="quest-count" id="visited-count">0 / 5</span></div>
      <div class="interact-wrap"><button class="interact-prompt" id="interact" hidden><kbd>E</kbd><span id="interact-label">Open project chest</span><span class="tap-label">Tap to open</span></button></div>
      <div class="world-toast" id="world-toast" role="status" aria-live="polite"></div>
      <div class="bottom-ui">
        <p id="game-instructions" class="keyboard-guide"><span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> move</span><span><kbd>E</kbd> interact</span><span>or click to walk</span></p>
        <nav class="hotbar" aria-label="Quick portfolio navigation">
          {destinations.map((d,i) => <button class={`hotbar-slot slot-${d.id}`} data-open={d.id} aria-label={`${d.name}, shortcut ${i+1}`} title={`${d.name} [${i+1}]`}><span class="slot-key">{i+1}</span><PixelIcon name={d.icon}/><span class="slot-name">{d.name}</span><span class="visited-dot" aria-hidden="true"></span></button>)}
        </nav>
        <div class="world-meta"><span class="status-dot"></span><span id="biome-label">Woodland · Golden hour</span><span class="coordinates" id="coordinates">X 768 / Y 540</span></div>
      </div>
      <div class="touch-controls" aria-label="Touch movement">
        <div class="dpad"><button data-dir="up" aria-label="Move up"><PixelIcon name="arrow"/></button><button data-dir="left" aria-label="Move left"><PixelIcon name="arrow"/></button><span aria-hidden="true"></span><button data-dir="right" aria-label="Move right"><PixelIcon name="arrow"/></button><button data-dir="down" aria-label="Move down"><PixelIcon name="arrow"/></button></div>
        <button class="touch-interact" id="touch-interact" disabled aria-label="Interact with nearby landmark"><PixelIcon name="chest"/><span>Interact</span></button>
      </div>
      <div class="loading-fallback" id="loading-fallback" hidden>The world couldn’t load. <a href={withBase('/work')}>Browse the projects instead →</a></div>
    </main>
    <dialog class="inventory" id="portfolio-dialog" aria-labelledby="panel-title">
      <div class="inventory-top"><span class="panel-icon" id="panel-icon"><PixelIcon name="chest"/></span><h2 id="panel-title">Project chest</h2><span class="panel-hint">Esc to return</span><button class="close-button icon-button" id="close-panel" aria-label="Close and return to world"><PixelIcon name="close"/></button></div>
      <section class="panel-content" data-panel="projects" aria-label="Projects">
        <div class="project-inventory">
          <div class="project-list" role="tablist" aria-label="Select a project" aria-orientation="vertical">
            {projects.map((p,i) => <button class:list={['project-slot',{'selected':i===0}]} id={`tab-${p.id}`} role="tab" aria-controls={`detail-${p.id}`} aria-selected={i===0 ? 'true':'false'} tabindex={i===0?0:-1} data-project={p.id}><span class={`project-item item-${i}`}><PixelIcon name={projectIcons[i]??'gem'}/></span><span><strong>{p.data.title}</strong><small>{p.data.category}</small></span><span class="project-select-arrow" aria-hidden="true">›</span></button>)}
            <p class="inventory-note">3 real builds.<br/>Each with a story behind it.</p>
            <a class="plain-link all-projects" href={withBase('/work')}>View all case studies ↗</a>
          </div>
          <div class="project-details">
            {projects.map((p,i) => <article id={`detail-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} class="project-detail" hidden={i!==0} tabindex="0"><div class={`project-art art-${i}`} aria-hidden="true"><PixelIcon name={projectIcons[i]??'gem'}/><span>{i===0?'RULES THAT HOLD.':i===1?'DEFEND BY DESIGN.':'FOLLOW THE SOURCE.'}</span><span class="art-pixels"></span></div><div class="project-heading"><h3>{p.data.title}</h3><span>{p.data.year}</span></div><p class="project-summary">{p.data.summary}</p><p class="project-role">{p.data.role}{p.data.team ? ` · ${p.data.team}` : ''}</p><ul class="stack-tags" aria-label="Technology stack">{p.data.stack.map(s=><li>{s}</li>)}</ul><div class="project-links"><a class="pixel-button primary" href={withBase(`/work/${p.id}`)}>Explore the build <PixelIcon name="arrow"/></a>{p.data.links.repo && <a class="plain-link" href={p.data.links.repo} target="_blank" rel="noopener noreferrer">Source code ↗</a>}{p.data.links.live && <a class="plain-link" href={p.data.links.live} target="_blank" rel="noopener noreferrer">Live project ↗</a>}</div></article>)}
          </div>
        </div>
      </section>
      <section class="panel-content text-panel" data-panel="about" hidden>
        <div class="about-layout"><div class="portrait-frame"><img src={withBase('/assets/portrait.jpg')} alt="Arihant Jain" width="400" height="500" loading="lazy"/><span>Player one: Arihant</span></div><div><h3>Curiosity is my crafting recipe.</h3><p>{person.statement}</p><p>I’m a {person.degree} undergraduate at {person.school} ({person.span}), based in {person.location}.</p><p>I care about where a system enforces its rules: in ARC’s database, in SentinelsAI’s deterministic fixes, and in a research pipeline’s source-backed reports.</p><div class="about-actions"><a class="pixel-button primary" href={withBase('/assets/resume.pdf')} target="_blank" rel="noopener">Read my résumé <PixelIcon name="arrow"/></a><a class="plain-link" href={withBase('/about')}>More about me ↗</a></div></div></div>
      </section>
      <section class="panel-content text-panel" data-panel="skills" hidden>
        <h3>The tools in my inventory.</h3><p class="panel-lede">Different problems, different tools. Here’s what I build with.</p><div class="skill-groups">{skills.map(g=><div class="skill-group"><h4>{g.group}</h4><ul>{g.items.map(s=><li>{s}</li>)}</ul></div>)}</div>
      </section>
      <section class="panel-content text-panel" data-panel="achievements" hidden>
        <h3>A few checkpoints along the way.</h3><div class="achievement-list">{achievements.map(a=><article><span class="achievement-value">{a.prefix}{a.value}{a.suffix}</span><div><h4>{a.event}</h4><p>{a.detail}</p></div><span class="achievement-year">{a.year}</span></article>)}</div><p class="panel-lede">Still exploring. Still building.</p>
      </section>
      <section class="panel-content text-panel" data-panel="contact" hidden>
        <div class="contact-art" aria-hidden="true"><PixelIcon name="mail"/><span class="contact-spark">+</span></div><h3>Got something worth building?</h3><p class="panel-lede">I’m looking for internships and opportunities in backend, infrastructure, and applied AI engineering. Let’s talk.</p><a class="contact-email" href={links.email}>{person.email} <span aria-hidden="true">↗</span></a><div class="contact-links"><a class="pixel-button primary" href={links.email}>Send an email <PixelIcon name="arrow"/></a><button class="text-button" id="copy-email" data-email={person.email}>Copy address</button><a class="plain-link" href={links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a class="plain-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="plain-link" href={links.x} target="_blank" rel="noopener noreferrer">X ↗</a></div><p class="contact-location"><span class="status-dot"></span>{person.location}</p>
      </section>
      <section class="panel-content text-panel" data-panel="help" hidden>
        <h3>A small world. Yours to explore.</h3><p class="panel-lede">Walk up to a landmark and interact to discover what’s inside. You can also open any section from the hotbar.</p><dl class="help-keys"><div><dt><kbd>W A S D</kbd> or <kbd>↑ ← ↓ →</kbd></dt><dd>Move around the world</dd></div><div><dt><kbd>E</kbd> or <kbd>Enter</kbd></dt><dd>Open the nearby landmark</dd></div><div><dt><kbd>1</kbd> to <kbd>5</kbd></dt><dd>Open a portfolio section instantly</dd></div><div><dt><kbd>Esc</kbd></dt><dd>Close the inventory and return</dd></div><div><dt>Mouse / touch</dt><dd>Click or tap the ground to walk. Tap a landmark to open it.</dd></div></dl><p>On a phone, use the directional pad and the Interact button. Sound effects are optional and off by default.</p><a class="plain-link" href={withBase('/work')}>Prefer a traditional portfolio? Browse the case studies ↗</a>
      </section>
      <div class="inventory-footer"><span><span class="status-dot"></span><span id="inventory-status">Found in the builder’s grove</span></span><span>Arihant’s inventory</span></div>
    </dialog>
    <section id="direct-portfolio" class="direct-portfolio" aria-label="Readable portfolio">
      <h2>{person.name}</h2><p>{person.statement}</p><p>{person.degree} · {person.school} · {person.span} · {person.location}</p>
      <h3>Projects</h3>{projects.map(p=><article><h4><a href={withBase(`/work/${p.id}`)}>{p.data.title}</a></h4><p>{p.data.summary}</p><p>{p.data.stack.join(' · ')}</p>{p.data.links.repo&&<a href={p.data.links.repo}>Source code ↗</a>}</article>)}
      <h3>Skills</h3>{skills.map(g=><p><strong>{g.group}: </strong>{g.items.join(', ')}</p>)}
      <h3>Milestones</h3>{achievements.map(a=><p>{a.prefix}{a.value}{a.suffix} · {a.event} ({a.year}) · {a.detail}</p>)}
      <h3>Get in touch</h3><p><a href={links.email}>{person.email}</a> · <a href={links.github}>GitHub</a> · <a href={links.linkedin}>LinkedIn</a> · <a href={links.x}>X</a> · <a href={withBase('/assets/resume.pdf')}>Résumé</a></p><a class="pixel-button" href={withBase('/')}>Return to the world</a>
    </section>
    <script>import '../scripts/world';</script>
  </body>
</html>
