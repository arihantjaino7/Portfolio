---
/**
 * One project entry in Chapter II — the centre of gravity of the home page.
 *
 * The figure lives inside the article in Phase 1. Phase 3 promotes these figures
 * into a single pinned plate at ≥1024px (DESIGN.md §5); the markup does not change,
 * which is why reduced-motion can simply return this document.
 */
import { assets, ratio } from '../config/assets';

interface Props {
  slug: string;
  title: string;
  year: number;
  summary: string;
  stack: string[];
  index: number;
}
const { slug, title, year, summary, stack, index } = Astro.props;
const media = assets.project(slug);
const href = `/work/${slug}`;
---

<article class="entry" data-project={index}>
  <a class="plate frame" href={href} tabindex="-1" aria-hidden="true" style={`aspect-ratio: ${ratio.media}`}>
    <img
      src={media.shot1}
      alt=""
      width="1920"
      height="1080"
      loading={index === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>

  <div class="head">
    <h3 class="title">
      <!-- The title is the link. No arrow appended — DESIGN.md §3. -->
      <a class="u" href={href}>{title}</a>
    </h3>
    <span class="meta year">{year}</span>
  </div>

  <hr />

  <p class="summary measure">{summary}</p>

  <p class="meta stack">{stack.map((s) => s.toLowerCase()).join(' · ')}</p>
</article>

<style>
  .entry + .entry { margin-top: clamp(4rem, 9vh, 7rem); }

  .plate { display: block; margin-bottom: 1.75rem; }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 0.9rem;
  }
  .title {
    font-size: var(--text-project);
    font-weight: 500;
    letter-spacing: -0.025em;
    margin: 0;
  }
  .year { flex-shrink: 0; }

  .summary { margin: 1.25rem 0 1rem; }
  .stack { margin: 0; }
</style>
