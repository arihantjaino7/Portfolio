---
/**
 * Homepage — REDESIGN.md §1, §2. All six sections built: S1 landing, S2
 * achievements (numbered expanding rows), S3 work (hover-reveal rows), S4
 * about, S5 capabilities marquee, S6 outro. The generic engine (Reveal /
 * data-count / data-parallax) does the animating; nothing here hand-rolls a
 * one-off tween.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { assets } from '../config/assets';
import { withBase } from '../config/paths';
import { person, achievements, skills, links } from '../config/site';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const skillItems = skills.flatMap((g) => g.items);
---

<Base ogImage={assets.og('default')} hideFooter>
  <!--
    Armed before first paint. Kept from the previous build: later phases that
    need a load-only entrance (not a scroll-triggered one) key off this class
    the same way the old hero did, without waiting on the motion bundle.
  -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion-pending');
      // Failsafe: if the motion bundle never lands (offline, blocked, parse
      // error) nothing would ever animate the reveals out of their hidden
      // state, so drop the gate and show the finished layout instead. motion.ts
      // clears the class itself as soon as it has wired the elements, which
      // makes this a no-op on the normal path.
      setTimeout(function () {
        document.documentElement.classList.remove('motion-pending');
      }, 4000);
    }
  </script>

  <!-- S1 — landing -->
  <section id="landing" class="screen landing">
    <HeroCanvas />
    <div class="landing-inner shell">
      <div class="landing-hero">
        <Reveal
          as="h1"
          class="landing-name"
          lines={[person.name.split(' ')[0], person.name.split(' ').slice(1).join(' ')]}
        />
        <Reveal as="p" class="landing-statement" delay={0.12}>{person.statement}</Reveal>
      </div>
      <div class="landing-meta">
        <span class="meta">{person.location}</span>
        <span class="meta" id="local-time" data-tz="Asia/Kolkata" aria-live="off"></span>
        <span class="meta landing-scroll" id="scroll-cue">scroll ↓</span>
      </div>
    </div>
  </section>

  <!-- S2 — achievements, sticky-stacked full-height panels -->
  <section id="achievements" class="dark-panel achievements">
    <div class="achievements-intro">
      <Reveal as="h2" class="achievements-title" lines={['Achievements']} />
    </div>

    <!--
      The stack effect is pure CSS `position: sticky` — each panel sticks one
      head-height lower than the one before it, and carries an opaque ground so
      the next panel occludes the previous panel's body while its head stays
      pinned. No ScrollTrigger pinning, which means it behaves identically with
      JS disabled and under prefers-reduced-motion: it is layout, not animation.
      `--i` drives both the sticky offset and the panel height so the two can
      never drift apart.
    -->
    <ol class="stack">
      {
        achievements.map((a, i) => (
          <li class="stack-item" style={`--i:${i}`}>
            <article class="ach">
              <div class="ach-inner">
                <div class="ach-head">
                  <span class="ach-index">{String(i + 1).padStart(2, '0')}.</span>
                  <span class="ach-figure">
                    {a.prefix}<span data-count={a.value}>{a.value}</span>{a.suffix}
                  </span>
                  <h3 class="ach-event">{a.event}</h3>
                  <span class="ach-year meta">{a.year}</span>
                </div>
                <div class="ach-body">
                  <p class="ach-detail meta">{a.detail}</p>
                  <p class="ach-blurb">{a.blurb}</p>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- S3 — work -->
  <section id="work" class="work-section">
    <div class="work-inner">
      <div class="work-head">
        <Reveal as="h2" class="work-title" lines={['Projects']} />
        <p class="work-lede-copy">
          One keeps competition rules honest inside the database. One grades a
          target's security without sending it a single packet. One won't write
          a line it can't trace back to a source.
        </p>
      </div>

      <!--
        One <a> per row and nothing interactive inside it: the reference puts a
        "live website" button in the hovered panel, but the whole row already
        navigates to the case study, so nesting a second link there would be
        invalid markup for no added destination. The pill is a presentational
        affordance instead, and the arrow is decorative.
      -->
      <ol class="proj-rows">
        {
          projects.map((p) => (
            <li class="proj">
              <a class="proj-link" href={withBase(`/work/${p.id}`)}>
                <span class="proj-panel" aria-hidden="true" />
                <span class="proj-meta meta">
                  {p.data.category ? `${p.data.year}, ${p.data.category}` : String(p.data.year)}
                </span>
                <span class="proj-thumb" aria-hidden="true">
                  <img
                    src={assets.project(p.id).shot1}
                    alt=""
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                {/*
                  Split per character so each letter can roll to its own light
                  copy on a stagger. aria-label carries the real title and every
                  fragment is aria-hidden, so a screen reader gets one word
                  rather than a stream of single letters.
                */}
                <h3 class="proj-title" aria-label={p.data.title}>
                  {[...p.data.title].map((ch, ci) =>
                    ch === ' ' ? (
                      <span class="ch-space" aria-hidden="true">
                        &nbsp;
                      </span>
                    ) : (
                      <span class="ch" style={`--c:${ci}`} aria-hidden="true">
                        <span class="ch-a">{ch}</span>
                        <span class="ch-b">{ch}</span>
                      </span>
                    ),
                  )}
                </h3>
                <span class="proj-icon" aria-hidden="true">↗</span>
                <span class="proj-cta meta" aria-hidden="true">↗ View case</span>
              </a>
            </li>
          ))
        }
      </ol>

      <a class="meta u all-work" href={withBase('/work')}>All work →</a>
    </div>
  </section>

  <!-- S4 — about -->
  <section id="about" class="screen dark-panel about-section">
    <div class="shell about-grid">
      <div class="about-portrait frame" data-reveal="clip">
        <img
          src={assets.portrait}
          alt={`${person.name}, portrait`}
          width="480"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-copy">
        <Reveal as="p" class="about-kicker" lines={['Hey —']} />
        <Reveal as="h2" class="about-name" lines={[`I'm ${person.name}.`]} delay={0.08} />
        <Reveal as="p" class="about-statement" delay={0.16}>{person.statement}</Reveal>
        <div class="about-row">
          <span class="tag meta">About me</span>
          <a class="meta u" href={withBase('/about')}>More about me →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- S5 — capabilities marquee -->
  <section id="capabilities" class="capabilities-section" aria-hidden="true">
    <div class="marquee-row">
      <div class="marquee-track marquee-left">
        {[...skillItems, ...skillItems].map((s) => <span class="meta">{s}</span>)}
      </div>
    </div>
    <div class="marquee-row">
      <div class="marquee-track marquee-right">
        {[...skillItems, ...skillItems].map((s) => <span class="meta">{s}</span>)}
      </div>
    </div>
  </section>

  <!-- S6 — outro -->
  <section id="outro" class="screen dark-panel outro">
    <div class="shell outro-inner">
      <Reveal as="p" class="outro-line" lines={["Let's build", 'something.']} />
      <a
        id="outro-email"
        class="outro-email"
        href={links.email}
        data-email={person.email}
      >
        {person.email}
      </a>
      <ul class="outro-links">
        <li><a class="meta u" href={links.github} rel="me noopener">GitHub ↗</a></li>
        <li><a class="meta u" href={links.linkedin} rel="me noopener">LinkedIn ↗</a></li>
        <li><a class="meta u" href={links.email}>Email ↗</a></li>
      </ul>
      <div class="outro-footer meta">
        <span>© {new Date().getFullYear()} {person.name}</span>
        <span>
          {person.location} — <span id="outro-time" data-tz="Asia/Kolkata"></span>
        </span>
        <a class="u" href="#landing">Back to top ↑</a>
      </div>
    </div>
  </section>

  <!--
    A handful of page-specific bits — a live clock (×2), a one-shot scroll
    cue, click-to-copy email — unrelated to the reveal/parallax/count
    vocabulary motion.ts generalizes, so they aren't routed through that
    engine. Independent of prefers-reduced-motion: they update text and
    toggle classes, they don't animate. The mailto href is real from the
    start, so copy-to-clipboard is a progressive enhancement, not the only
    path — email still works with this script absent.
  -->
  <script>
    function liveClock(el: HTMLElement) {
      const tz = el.dataset.tz ?? 'Asia/Kolkata';
      const fmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: tz,
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      });
      const update = () => (el.textContent = fmt.format(new Date()));
      update();
      setInterval(update, 30_000);
    }
    document
      .querySelectorAll<HTMLElement>('#local-time, #outro-time')
      .forEach(liveClock);

    const cue = document.getElementById('scroll-cue');
    if (cue) {
      window.addEventListener('scroll', () => cue.classList.add('is-hidden'), {
        once: true,
        passive: true,
      });
    }

    const emailLink = document.getElementById('outro-email');
    if (emailLink && navigator.clipboard) {
      emailLink.addEventListener('click', (e) => {
        const address = emailLink.dataset.email;
        if (!address) return;
        e.preventDefault();
        navigator.clipboard.writeText(address).then(() => {
          const original = emailLink.textContent;
          emailLink.textContent = 'copied';
          setTimeout(() => (emailLink.textContent = original), 1500);
        });
      });
    }
  </script>

  <!-- Home only — every other route stays at zero client JS. -->
  <script>
    import '../scripts/motion';
  </script>
</Base>

<style>
  /* The sticky header (SiteHeader.astro) permanently covers --header-h of the
     viewport. Since scroll-padding-top lands a snapped section's top just
     below the header, a plain 100svh section would run --header-h past the
     visible viewport bottom — the same fold problem this component exists to
     avoid, just moved to the other edge. Sized to what is actually visible
     once landed, not the raw viewport. */
  .screen {
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
  }

  /* ── S1 landing ─────────────────────────────────────────────── */
  .landing {
    position: relative;
    align-items: stretch;
    overflow: hidden;
  }

  .landing-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .landing-hero {
    align-self: center;
  }

  /* :global — these classes land on <Reveal>'s own root element, which
     carries Reveal.astro's scope hash rather than this file's, so a plain
     scoped selector here would silently never match. Same story everywhere
     else below that styles a class passed into <Reveal>. */
  .landing-hero :global(.landing-name) {
    font-family: var(--font-compress);
    font-size: var(--text-display);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .landing-hero :global(.landing-statement) {
    margin: 1.25rem 0 0;
    max-width: 34ch;
    color: var(--color-muted);
    font-size: clamp(1rem, 0.6vw + 0.85rem, 1.25rem);
  }

  .landing-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
  }

  .landing-scroll {
    transition: opacity 500ms ease;
  }

  .landing-scroll.is-hidden {
    opacity: 0;
  }

  /* ── shared section heading ─────────────────────────────────── */
  :global(.section-title) {
    font-family: var(--font-compress);
    font-size: var(--text-chapter);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0;
  }

  /* ── S2 achievements — sticky-stacked panels ────────────────── */
  /* One set of column measures drives the head grid, the body indent and the
     intro indent, so the index / figure / event / paragraph all land on the
     same x down the whole section. */
  .achievements {
    --col-index: 4.5rem;
    --col-figure: 9rem;
    --col-gap: 2rem;
    --content-indent: calc(var(--col-index) + var(--col-figure) + var(--col-gap) * 2);
    --head-h: 6.5rem;
    /* Same thin inline pad the work section uses, so the achievements heading
       and rows sit on the identical left edge as the project rows do — the
       84rem centred shell they used before pulled them visibly inward. */
    --ach-pad: clamp(0.75rem, 1.4vw, 1.5rem);
  }

  @media (min-width: 860px) {
    .achievements {
      --head-h: 7rem;
    }
  }

  /* --title-nudge: the headings sit a hair inside the rows' left edge rather
     than flush with it. Shared with .work-title so the two can't drift. */
  .achievements-intro {
    --title-nudge: clamp(0.5rem, 0.9vw, 1rem);
    padding-block: clamp(4rem, 13vh, 8rem) clamp(2rem, 7vh, 4rem);
    padding-inline: calc(var(--ach-pad) + var(--title-nudge)) var(--ach-pad);
  }

  /* Matched to .work-title exactly — same face, same clamp, same fit — so the
     two section headings read as one system rather than two. Anton ships a
     single weight, hence 400 rather than a bolder number that would only
     trigger synthesis. */
  .achievements-intro :global(.achievements-title) {
    font-family: var(--font-compress);
    font-size: clamp(2.25rem, 6.5vw, 5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.92;
    margin: 0;
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack-item {
    position: sticky;
    /* Shifted down by the sticky header's own height (global.css --header-h)
       — it permanently covers that band of the viewport now, so panel 0's
       head would render directly underneath it without this. */
    top: calc(var(--header-h) + var(--i) * var(--head-h));
  }

  .ach {
    /* Each panel fills the viewport *below* the header and the heads already
       stacked above it, so no panel's content is pushed under the fold. */
    min-height: calc(100svh - var(--header-h) - var(--i) * var(--head-h));
    display: flex;
    flex-direction: column;
    /* Opaque ground is what makes the occlusion read — without it the panel
       below would show through as this one scrolls over it. */
    background: var(--color-ground);
    border-top: 1px solid var(--color-rule);
    padding-inline: var(--ach-pad);
  }

  .ach-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .ach-head {
    height: var(--head-h);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "index figure year"
      "event event event";
    align-items: center;
    gap: 0.25rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 860px) {
    .ach-head {
      grid-template-columns: var(--col-index) var(--col-figure) minmax(0, 1fr) auto;
      grid-template-areas: "index figure event year";
      gap: var(--col-gap);
    }
  }

  .ach-index {
    grid-area: index;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ach-figure {
    grid-area: figure;
    font-family: var(--font-mono);
    font-size: clamp(1.2rem, 2.3vw, 1.75rem);
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .ach-event {
    grid-area: event;
    /* Sized to keep the longest event name on one line inside a fixed-height
       head — the head height is what the sticky offsets are computed from, so
       it must not grow. The serif sets wider than the sans it replaced, so the
       ceiling here is lower than the type scale would otherwise suggest. */
    font-family: var(--font-compress);
    font-size: clamp(1.05rem, 2.9vw, 2.125rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .ach-year {
    grid-area: year;
    justify-self: end;
  }

  /* Top-aligned, not centred in the panel: the paragraph has to read as
     belonging to the head directly above it. The space left below is the
     region the next panel scrolls over first, so it is never dead for long. */
  .ach-body {
    padding-block: clamp(2rem, 8vh, 4.5rem) clamp(2rem, 6vh, 3.5rem);
  }

  @media (min-width: 860px) {
    /* Line the paragraph up under the event name, not under the index. */
    .ach-body {
      padding-left: var(--content-indent);
    }
  }

  .ach-detail {
    color: var(--color-accent);
    margin: 0 0 1.25rem;
  }

  .ach-blurb {
    margin: 0;
    max-width: 48ch;
    font-size: clamp(1.0625rem, 1.35vw, 1.375rem);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* ── S3 work ─────────────────────────────────────────────────── */
  /* Full height like the achievements section, but the rows sit at their
     natural size at the top rather than stretching to fill it — the empty
     space below is deliberate room for projects that do not exist yet.

     This section deliberately does NOT use .shell: the rows are meant to run
     almost the full width of the screen, and .shell would cap them at 84rem
     and centre them. --work-pad is the thin margin left at the edges instead,
     and the heading hugs the same left edge as the rows rather than sitting
     on the centred grid the rest of the page uses. */
  .work-section {
    --work-pad: clamp(0.75rem, 1.4vw, 1.5rem);
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-block: clamp(4rem, 13vh, 8rem) clamp(3rem, 10vh, 6rem);
    padding-inline: var(--work-pad);
  }

  .work-inner {
    width: 100%;
  }

  /* Title left, lede held to a column on the right — at full width a plain
     space-between would fling the lede to the far edge of a wide screen. */
  .work-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    align-items: start;
    gap: 2rem;
    margin-bottom: clamp(3rem, 12vh, 7rem);
  }

  .work-head :global(.work-title) {
    padding-left: clamp(0.5rem, 0.9vw, 1rem);
    font-family: var(--font-compress);
    font-size: clamp(2.25rem, 6.5vw, 5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.92;
    margin: 0;
  }

  .work-lede-copy {
    margin: 0;
    max-width: 34ch;
    justify-self: end;
    /* Body face at body size: it has to read as prose beside the headline,
       which .meta's caption sizing would not. */
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  @media (max-width: 54rem) {
    .work-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .work-lede-copy {
      justify-self: start;
    }
  }

  .proj-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .proj-link {
    position: relative;
    display: grid;
    align-items: center;
    /* meta | thumb | title | arrow, with the CTA on a second row under the
       title. The thumb column is 0 until hover, which is what slides the
       title across as the panel arrives. */
    grid-template-columns: minmax(0, var(--meta-col)) auto minmax(0, 1fr) auto;
    grid-template-areas:
      "meta thumb title icon"
      "meta thumb cta   icon";
    column-gap: clamp(0.85rem, 1.6vw, 1.5rem);
    /* Minimal inline padding so the row's text starts almost at the screen
       edge and the slab runs nearly the full width behind it. */
    padding: clamp(1rem, 2.4vh, 1.45rem) clamp(0.6rem, 1vw, 0.9rem);
    border-top: 1px solid var(--color-rule);
    color: inherit;
    isolation: isolate;
    /* Clips the skewed slab's slanted ends, and rounds the panel with it. */
    overflow: hidden;
    border-radius: 0.5rem;
    transition: padding 480ms cubic-bezier(0.4, 0, 0.2, 1);
    --meta-col: 13rem;
  }

  .proj:last-child .proj-link {
    border-bottom: 1px solid var(--color-rule);
  }

  /* The fill, and the first half of what distinguishes this section from the
     header's radial one: a *skewed* slab that sweeps in from the left, so the
     leading edge arrives on a diagonal and the row reads as being struck
     rather than filled. Over-wide and over-tall so the slanted ends never
     expose a corner; .proj-link's overflow does the clipping. */
  .proj-panel {
    position: absolute;
    inset: -1px -12%;
    z-index: -1;
    background: var(--color-text);
    /* Just past its own width — enough to sit fully off the left edge, and no
       further. Over-travelling spends the first third of the duration moving
       through nothing, which reads as lag before the slab appears. */
    transform: translateX(-101%) skewX(-9deg);
    transition: transform 620ms cubic-bezier(0.5, 0.05, 0.25, 1);
  }

  .proj-meta {
    grid-area: meta;
    transition: color 260ms ease 120ms;
  }

  /* Width, not opacity: the column has to actually open up and push the title
     across, which is the movement that sells the row expanding. */
  .proj-thumb {
    grid-area: thumb;
    width: 0;
    overflow: hidden;
    border-radius: 0.25rem;
    transition:
      width 520ms cubic-bezier(0.62, 0.04, 0.3, 1),
      opacity 300ms ease 140ms;
    opacity: 0;
  }

  .proj-thumb img {
    width: 11rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .proj-title {
    grid-area: title;
    font-family: var(--font-compress);
    font-size: clamp(1.35rem, 3.2vw, 2.5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.02;
    margin: 0;
  }

  /* The second half of the effect: every letter is two stacked copies, a dark
     one sitting in place and a light one waiting below. On hover both rise by
     exactly one line, so the title doesn't fade or recolour — each glyph rolls
     over to its light twin, left to right, just behind the slab's edge. */
  .ch {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: top;
  }

  .ch-space {
    display: inline-block;
  }

  .ch-a,
  .ch-b {
    display: block;
    transition: transform 600ms cubic-bezier(0.62, 0.04, 0.3, 1);
    /* Staggered off the character's index, so the roll chases the slab across
       the row rather than flipping the whole word at once. */
    /* Capped: a 29-character title would otherwise put the last glyph 700ms
