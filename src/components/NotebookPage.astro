---
/**
 * One page of a project notebook.
 *
 * Extracted from ProjectNotebook.astro because a two-page book is built from
 * sheets, and each sheet renders a page on its front and another on its back —
 * the same markup in two places. An .astro file cannot declare a local
 * component to do that, so it becomes a real one.
 *
 * `kind` picks which spine section this page carries. `page` is null for the
 * blank that falls at the end of a book with an even page count, which renders
 * as bare paper rather than as an error.
 */
import type { CollectionEntry } from 'astro:content';
import ArchDiagram from './ArchDiagram.astro';
import { withBase } from '../config/paths';

export interface NotebookLeaf {
  kind: 'problem' | 'arch' | 'decision' | 'proof' | 'stack';
  label: string;
  numeral: string;
}

interface Props {
  entry: CollectionEntry<'work'>;
  page: NotebookLeaf | null;
}
const { entry, page } = Astro.props;
const d = entry.data;
---

{
  page && (
    <div class="nb-sheet-body">
      <p class="nb-numeral meta">
        <span class="nb-roman">{page.numeral}</span>
        {page.label}
      </p>

      {page.kind === 'problem' && <p class="nb-lede">{d.problem}</p>}

      {page.kind === 'arch' && d.diagram && (
        <div class="nb-diagram">
          <ArchDiagram
            caption={d.diagram.caption}
            svg={d.diagram.svg}
            layers={d.diagram.layers}
            title={d.title}
          />
        </div>
      )}

      {page.kind === 'decision' && d.decision && (
        <div class="nb-decision">
          <h3 class="nb-q">{d.decision.question}</h3>
          <div class="nb-cols">
            <div>
              <p class="meta nb-key">chose</p>
              <p class="nb-chose">{d.decision.chose}</p>
            </div>
            <div>
              <p class="meta nb-key">rejected</p>
              <ul class="nb-rejected">
                {d.decision.rejected.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>
          </div>
          <p class="nb-why">{d.decision.why}</p>
        </div>
      )}

      {page.kind === 'proof' && d.proof && (
        <div class="nb-proof">
          <p class="nb-figure">{d.proof.summary}</p>
          {d.proof.caption && <p class="nb-why">{d.proof.caption}</p>}
          <a class="meta u" href={withBase(`/work/${entry.id}`)}>
            Read the artifact in full →
          </a>
        </div>
      )}

      {page.kind === 'stack' && (
        <ul class="nb-stack">
          {d.stack.map((s) => (
            <li class="meta">{s}</li>
          ))}
        </ul>
      )}
    </div>
  )
}

<style is:global>
  /* Global rather than scoped: these rules style this component's own markup,
     but the sheet/face geometry that positions it lives in ProjectNotebook,
     and keeping the type here scoped would need :global() on every selector
     anyway once the two files' scope hashes differ. */
  .nb-sheet-body {
    position: relative;
  }

  .nb-numeral {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0 0 clamp(1.25rem, 3vh, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nb-roman {
    color: var(--color-accent);
  }

  .nb-lede {
    margin: 0;
    max-width: 38ch;
    font-size: clamp(1.0625rem, 1.25vw, 1.3125rem);
    line-height: 1.5;
  }

  .nb-diagram {
    max-width: 100%;
  }

  /* ArchDiagram holds its SVG at min-width: 560px and scrolls the overflow —
     right for a full-width case study, wrong for a notebook page half a book
     wide, where it would clip the last column out of sight. Here the viewBox
     scales instead. The tag raises specificity above the component's own rule
     so source order cannot decide it.

     Only above the breakpoint: on a phone the page is ~360px, and scaling a
     five-column diagram into that renders type nobody can read. There the
     component's own scroll behaviour is the better answer. */
  @media (min-width: 46rem) {
    .nb-diagram svg.svg {
      min-width: 0;
      width: 100%;
    }
  }

  .nb-q {
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 1.25vw, 1.25rem);
    font-weight: 600;
    margin: 0 0 1.25rem;
    max-width: 34ch;
  }

  .nb-cols {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .nb-key {
    margin: 0 0 0.5rem;
    color: var(--color-muted);
    text-transform: lowercase;
  }

  .nb-chose {
    margin: 0;
    color: var(--color-accent);
    max-width: 32ch;
  }

  .nb-rejected {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    display: grid;
    gap: 0.5rem;
    max-width: 34ch;
  }

  .nb-why {
    margin: 0 0 1rem;
    max-width: 52ch;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .nb-figure {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    margin: 0 0 1rem;
  }

  .nb-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .nb-stack li {
    border: 1px solid var(--color-rule);
    border-radius: 0.25rem;
    padding: 0.4rem 0.7rem;
  }
</style>
