---
/**
 * Project notebook — the home page's reading layer.
 *
 * Clicking a work row opens the project as an open book: two pages at a time,
 * click the left page to go back, the right page to go forward. One page per
 * spine section, in the order the case study uses them.
 *
 * The sheet model is what makes it a book rather than a slideshow. A sheet is
 * one piece of paper carrying two pages: page 2k on its front, 2k+1 on its
 * back. At turn state t, t sheets have been turned to the left, so the spread
 * shows the back of sheet t-1 on the left and the front of sheet t on the
 * right. Turning a sheet therefore reveals two new pages at once and moves the
 * one you just read to the left-hand side, exactly as paper does.
 *
 * Progressive enhancement, top to bottom:
 *   - The row stays a real <a href="/work/<slug>">. With JS off, a <dialog>
 *     without [open] is display:none, the click is never intercepted, and the
 *     reader gets the full page. Nothing here is the only route to anything.
 *   - <dialog>.showModal() supplies the focus trap, the Esc handler, the inert
 *     background and ::backdrop for free — none of that is hand-rolled.
 *   - The turn is a rotateY about the sheet's spine edge with shading swept
 *     across it mid-turn. It is not a deforming curl (that needs geometry this
 *     page has no business shipping); it is a hinge that reads as paper.
 *   - Under prefers-reduced-motion the global rule in global.css collapses
 *     every transition here, so spreads swap instantly and nothing is lost.
 *   - Below 46rem two pages side by side would be unreadable, so the book
 *     keeps its spread and the viewport pans to whichever page you are on.
 *     Same markup, same sheets, same turns — only the window narrows.
 *
 * Every page is rendered server-side, so the whole notebook is in the HTML and
 * the JS only ever toggles classes.
 */
import type { CollectionEntry } from 'astro:content';
import NotebookPage from './NotebookPage.astro';
import type { NotebookLeaf } from './NotebookPage.astro';
import { withBase } from '../config/paths';

interface Props {
  projects: CollectionEntry<'work'>[];
}
const { projects } = Astro.props;

const NUMERALS = ['I', 'II', 'III', 'IV', 'V', 'VI'];

/**
 * Which pages a project gets. diagram, decision and proof are all optional in
 * the schema, so this is computed per project rather than assumed — a case
 * study with only a problem opens as a two-page book instead of breaking.
 */
function pagesFor(entry: CollectionEntry<'work'>): NotebookLeaf[] {
  const d = entry.data;
  const spine: Array<Omit<NotebookLeaf, 'numeral'>> = [
    { kind: 'problem', label: 'Problem' },
    ...(d.diagram ? [{ kind: 'arch' as const, label: 'Architecture' }] : []),
    ...(d.decision ? [{ kind: 'decision' as const, label: 'Decision' }] : []),
    ...(d.proof ? [{ kind: 'proof' as const, label: 'Proof' }] : []),
    { kind: 'stack', label: 'Stack' },
  ];
  return spine.map((s, i) => ({ ...s, numeral: NUMERALS[i] }));
}

/** Pages paired onto sheets: front 2k, back 2k+1. The last back may be blank. */
function sheetsFor(pages: NotebookLeaf[]) {
  const sheets: Array<{ front: NotebookLeaf | null; back: NotebookLeaf | null }> = [];
  for (let k = 0; k * 2 < pages.length; k++) {
    sheets.push({ front: pages[2 * k] ?? null, back: pages[2 * k + 1] ?? null });
  }
  return sheets;
}
---

{
  projects.map((p) => {
    const pages = pagesFor(p);
    const sheets = sheetsFor(pages);
    const hasLinks = Boolean(p.data.links.repo || p.data.links.live);
    return (
      <dialog class="nb" id={`nb-${p.id}`} aria-label={`${p.data.title}, project notebook`}>
        <div class="nb-shell">
          <header class="nb-chrome">
            <div class="nb-ident">
              <h2 class="nb-title">{p.data.title}</h2>
              <p class="nb-sub meta">
                {p.data.category ? `${p.data.year}, ${p.data.category}` : String(p.data.year)}
              </p>
            </div>
            <div class="nb-chrome-actions">
              <button type="button" class="nb-btn" data-nb-details>
                Links &amp; details
              </button>
              <button type="button" class="nb-btn nb-close" data-nb-close aria-label="Close notebook">
                Close
              </button>
            </div>
          </header>

          <div class="nb-viewport" data-nb-viewport>
            <div
              class="nb-book"
              style={`--sheets:${sheets.length}`}
              data-nb-book
              data-pages={pages.length}
            >
              {/*
                The boards are the inside covers: what shows through where no
                sheet is currently lying. Left is bare until the first turn,
                right goes bare on the last spread of an even-paged book.
              */}
              <div class="nb-board nb-board-left" aria-hidden="true">
                <span class="nb-board-mark meta">{p.data.title}</span>
              </div>
              <div class="nb-stack-col">
                <div class="nb-board nb-board-right" aria-hidden="true" />
                {sheets.map((sh, k) => (
                  <article class="nb-sheet" style={`--k:${k}`} data-nb-sheet={k}>
                    <div class="nb-face nb-front">
                      <span class="nb-shade" aria-hidden="true" />
                      <div class="nb-sheet-scroll">
                        <NotebookPage entry={p} page={sh.front} />
                      </div>
                    </div>
                    <div class="nb-face nb-back">
                      <span class="nb-shade" aria-hidden="true" />
                      <div class="nb-sheet-scroll">
                        <NotebookPage entry={p} page={sh.back} />
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>

            {/*
              Click targets, not decoration: a transparent half over the
              viewport. They belong to the viewport rather than the book because
              on a narrow screen the book is twice the viewport's width and
              panned — halves of the book would mean "the left page" and "the
              right page", and on a left-hand page every tap would go backwards.
              Halves of the window always mean back and forward.

              They sit above the sheets, so the script hands a click through
              when what is underneath is a link or a button.
            */}
            <button type="button" class="nb-zone nb-zone-back" data-nb-prev aria-label="Previous pages" />
            <button type="button" class="nb-zone nb-zone-fwd" data-nb-next aria-label="Next pages" />
          </div>

          <nav class="nb-nav" aria-label="Notebook pages">
            <ol class="nb-index">
              {pages.map((page, i) => (
                <li>
                  <button type="button" class="nb-dot" data-nb-go={i}>
                    <span class="nb-dot-n meta">{page.numeral}</span>
                    <span class="nb-dot-label meta">{page.label}</span>
                  </button>
                </li>
              ))}
            </ol>
            <p class="nb-hint meta" aria-hidden="true">click a page to turn it</p>
          </nav>

          {/*
            The details card. Not a nested <dialog> — nesting modals fights the
            parent's focus trap. It is a layer inside this one, and the JS marks
            the book inert while it is up, which gets the same result.
          */}
          <div class="nb-details-layer" data-nb-details-layer hidden>
            <div class="nb-card" role="group" aria-label={`${p.data.title} links and details`}>
              <p class="meta nb-key">details</p>
              <h3 class="nb-card-title">{p.data.title}</h3>
              <p class="nb-card-sum">{p.data.summary}</p>

              <dl class="nb-facts">
                <div>
                  <dt class="meta nb-key">year</dt>
                  <dd class="meta">{p.data.year}</dd>
                </div>
                {p.data.category && (
                  <div>
                    <dt class="meta nb-key">kind</dt>
                    <dd class="meta">{p.data.category}</dd>
                  </div>
                )}
              </dl>

              <ul class="nb-chips">
                {p.data.stack.map((s) => (
                  <li class="meta">{s}</li>
                ))}
              </ul>

              <div class="nb-links">
                {p.data.links.live && (
                  <a class="nb-link nb-link-lead" href={p.data.links.live} rel="noopener">
                    <span class="meta nb-key">live</span>
                    <span class="nb-link-text">Visit the site ↗</span>
                  </a>
                )}
                {p.data.links.repo && (
                  <a class="nb-link" href={p.data.links.repo} rel="noopener">
                    <span class="meta nb-key">source</span>
                    <span class="nb-link-text">GitHub repository ↗</span>
                  </a>
                )}
                {!hasLinks && (
                  <p class="nb-noline meta">No public repository or deployment yet.</p>
                )}
                <a class="nb-link" href={withBase(`/work/${p.id}`)}>
                  <span class="meta nb-key">long form</span>
                  <span class="nb-link-text">Full case study →</span>
                </a>
              </div>

              <button type="button" class="nb-btn nb-card-close" data-nb-details-close>
                Back to the notebook
              </button>
            </div>
          </div>
        </div>
      </dialog>
    );
  })
}

<style>
  /* ── shell ───────────────────────────────────────────────────── */
  .nb {
    width: min(82rem, 100vw - 2rem);
    max-width: none;
    height: min(46rem, 100svh - 2rem);
    max-height: none;
    /* Explicit, not inherited: a modal <dialog> is centred by the UA's
       `margin: auto`, and Tailwind's preflight zeroes every element's margin —
       without this the notebook pins itself to the top-left corner. */
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    overflow: visible;
  }

  .nb::backdrop {
    background: rgba(8, 9, 11, 0.86);
    backdrop-filter: blur(3px);
  }

  .nb-shell {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(0.75rem, 2vh, 1.25rem);
  }

  /* ── chrome ──────────────────────────────────────────────────── */
  .nb-chrome {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: #f2f1ed;
  }

  .nb-title {
    font-family: var(--font-compress);
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1;
    margin: 0;
  }

  .nb-sub {
    margin: 0.35rem 0 0;
    color: rgba(242, 241, 237, 0.62);
  }

  .nb-chrome-actions {
    display: flex;
    gap: 0.5rem;
  }

  .nb-btn {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: #f2f1ed;
    background: transparent;
    border: 1px solid rgba(242, 241, 237, 0.3);
    border-radius: 0.25rem;
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .nb-btn:hover,
  .nb-btn:focus-visible {
    background: #f2f1ed;
    border-color: #f2f1ed;
    color: #14151a;
  }

  /* ── the book ────────────────────────────────────────────────── */
  .nb-viewport {
    position: relative;
    height: 100%;
    /* Desktop: visible, so a sheet's drop shadow is not clipped mid-turn.
       The narrow-screen rule flips this to hidden, which is what turns the
       viewport into a window onto one page of the spread. */
    overflow: visible;
  }

  /* perspective without preserve-3d: the book stays a flat stacking context so
     z-index still orders the sheets, while each sheet gets its own 3D space for
     its two faces. preserve-3d here would hand sorting to the geometry and the
     stack would shuffle itself mid-turn. */
  .nb-book {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    perspective: 2800px;
  }

  .nb-board {
    background: var(--color-ground-deep);
    border-radius: 0.3rem;
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 60px rgba(20, 21, 26, 0.12);
  }

  .nb-board-mark {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .nb-stack-col {
    position: relative;
    grid-column: 2;
  }

  .nb-board-right {
    position: absolute;
    inset: 0;
  }

  .nb-sheet {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    /* The spine. Every sheet hinges on the middle of the book. */
    transform-origin: left center;
    transition: transform 820ms cubic-bezier(0.22, 0.61, 0.24, 1);
    z-index: calc(var(--sheets) - var(--k));
  }

  /* 178deg rather than 180: a face exactly edge-on to the viewer flickers
     between itself and its backface on some GPUs. Two degrees of rake is
     invisible and stops it. */
  .nb-sheet.is-turned {
    transform: rotateY(-178deg);
    /* Turned sheets pile on the left in the order they were turned, so the one
       you just read sits on top of the one before it. */
    z-index: calc(var(--sheets) + var(--k) + 1);
  }

  .nb-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    background: var(--color-ground);
    border-radius: 0.3rem;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(8, 9, 11, 0.45);
  }

  .nb-back {
    transform: rotateY(180deg);
  }

  /* Paper depth at the spine. The back face is mirrored by its own rotation, so
     a gradient on its local left edge lands on screen-right — which is exactly
     where the spine is for a left-hand page. One rule serves both faces. */
  .nb-face::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3.5rem;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgba(20, 21, 26, 0.13),
      rgba(20, 21, 26, 0.03) 55%,
      transparent
    );
  }

  /* Swept across the sheet mid-turn. An animation, not a transition, because
     the shadow has to rise and fall inside one turn — a transition can only go
     one way. JS adds .is-turning for exactly the turn's duration. */
  .nb-shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      100deg,
      rgba(8, 9, 11, 0.5),
      rgba(8, 9, 11, 0.1) 45%,
      transparent 70%
    );
  }

  .nb-sheet.is-turning .nb-shade {
    animation: nb-curl 820ms cubic-bezier(0.22, 0.61, 0.24, 1);
  }

  @keyframes nb-curl {
    0% { opacity: 0; }
    42% { opacity: 1; }
    100% { opacity: 0; }
  }

  .nb-sheet-scroll {
    position: relative;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.25rem, 2.6vw, 2.5rem);
    padding-left: clamp(2.75rem, 4.5vw, 4rem);
  }

  /* ── click zones ─────────────────────────────────────────────── */
  /* Transparent halves over the spread. A <button> rather than a div so the
     turn is reachable by keyboard and announced, and so it needs no role. */
  .nb-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 20;
    border: 0;
    background: transparent;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
  }

  .nb-zone-back {
    left: 0;
    cursor: w-resize;
  }

  .nb-zone-fwd {
    right: 0;
    cursor: e-resize;
  }

  .nb-zone:disabled {
    cursor: default;
  }

  .nb-zone:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -4px;
  }

  /* ── nav ─────────────────────────────────────────────────────── */
  .nb-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: #f2f1ed;
  }

  .nb-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .nb-dot {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    background: transparent;
    border: 0;
    border-top: 1px solid rgba(242, 241, 237, 0.24);
    padding: 0.5rem 0.65rem 0.4rem;
    cursor: pointer;
    color: rgba(242, 241, 237, 0.55);
    transition: color 200ms ease, border-color 200ms ease;
  }

  .nb-dot:hover,
  .nb-dot:focus-visible {
    color: #f2f1ed;
    border-color: #f2f1ed;
  }

  .nb-dot[aria-current='true'] {
    color: #f2f1ed;
    border-color: var(--color-accent);
  }

  .nb-dot-n {
    color: var(--color-accent);
  }

  .nb-dot-label {
    display: none;
    /* .meta sets color: var(--color-muted), which is dark ink — this chrome
       sits on the dark backdrop, not on paper, so it has to opt out. */
    color: inherit;
  }

  .nb-hint {
    margin: 0;
    color: rgba(242, 241, 237, 0.4);
  }

  @media (min-width: 46rem) {
    .nb-dot-label {
      display: inline;
    }
  }

  /* ── details layer ───────────────────────────────────────────── */
  .nb-details-layer {
    position: absolute;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(8, 9, 11, 0.55);
    border-radius: 0.3rem;
  }

  .nb-details-layer[hidden] {
    display: none;
  }

  .nb-card {
    width: min(34rem, 100%);
    max-height: 100%;
    overflow-y: auto;
    background: var(--color-ground);
    border-radius: 0.3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 30px 80px rgba(8, 9, 11, 0.6);
  }

  .nb-card-title {
    font-family: var(--font-compress);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1;
    margin: 0 0 0.75rem;
  }

  .nb-card-sum {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    max-width: 44ch;
  }

  .nb-facts {
    display: flex;
    gap: 2rem;
    margin: 0 0 1.25rem;
  }

  .nb-facts dt,
  .nb-facts dd {
    margin: 0;
  }

  .nb-chips {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .nb-chips li {
    border: 1px solid var(--color-rule);
    border-radius: 0.25rem;
    padding: 0.4rem 0.7rem;
  }

  .nb-links {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .nb-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--color-rule);
    padding: 0.85rem 0.25rem;
    transition: padding-left 260ms cubic-bezier(0.4, 0, 0.2, 1), color 200ms ease;
  }

  .nb-link:hover,
  .nb-link:focus-visible {
    padding-left: 0.85rem;
    color: var(--color-accent);
  }

  .nb-link-text {
    font-family: var(--font-compress);
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .nb-link-lead .nb-link-text {
    color: var(--color-accent);
  }

  .nb-noline {
    margin: 0;
    padding: 0.85rem 0.25rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-muted);
  }

  .nb-card-close {
    color: var(--color-text);
    border-color: var(--color-rule);
  }

  .nb-card-close:hover,
  .nb-card-close:focus-visible {
    background: var(--color-text);
    color: var(--color-ground);
    border-color: var(--color-text);
  }

  /* ── small screens ───────────────────────────────────────────── */
  /* Two pages side by side below this width would be ~180px each, which is not
     reading. The book keeps its spread and the viewport becomes a window onto
     one page of it — same sheets, same turns, half as much shown at a time. */
  @media (max-width: 46rem) {
    .nb {
      width: 100vw;
      height: 100svh;
      max-height: 100svh;
    }
    .nb-shell {
      padding: 0.75rem;
    }
    .nb-chrome-actions {
      width: 100%;
    }
    .nb-btn {
      flex: 1;
    }
    .nb-viewport {
      overflow: hidden;
    }
    .nb-book {
      width: 200%;
      transition: transform 420ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .nb-book[data-half='right'] {
      transform: translateX(-50%);
    }
    .nb-hint {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const books = document.querySelectorAll('.nb');
    if (!books.length || typeof HTMLDialogElement === 'undefined') return;

    /** Matches the .nb-sheet transition duration; the shading animation shares it. */
    const TURN_MS = 820;
    const narrow = window.matchMedia('(max-width: 46rem)');

    books.forEach((dlg) => {
      const book = dlg.querySelector('[data-nb-book]');
      const viewport = dlg.querySelector('[data-nb-viewport]');
      const sheets = Array.from(dlg.querySelectorAll('[data-nb-sheet]'));
      const dots = Array.from(dlg.querySelectorAll('[data-nb-go]'));
      const zoneBack = dlg.querySelector('[data-nb-prev]');
      const zoneFwd = dlg.querySelector('[data-nb-next]');
      const detailsLayer = dlg.querySelector('[data-nb-details-layer]');
      const nav = dlg.querySelector('.nb-nav');
      const shell = dlg.querySelector('.nb-shell');
      if (!book || !sheets.length) return;

      const total = Number(book.dataset.pages);
      /** Highest turn state that still brings a new page into view. */
      const tMax = Math.ceil((total - 1) / 2);
      /** Which spread a given page appears in: fronts are even, backs are odd. */
      const spreadOf = (i) => Math.ceil(i / 2);

      // State is the page you are reading. The spread follows from it, which
      // keeps the index, the desktop spread stepper and the narrow-screen page
      // stepper all driving one number instead of three.
      let page = 0;
      let turnState = 0;

      function render() {
        const t = Math.min(tMax, spreadOf(page));
        if (t !== turnState) {
          const lo = Math.min(turnState, t);
          const hi = Math.max(turnState, t);
          for (let k = lo; k < hi; k++) {
            const sheet = sheets[k];
            if (!sheet) continue;
            sheet.classList.add('is-turning');
            setTimeout(() => sheet.classList.remove('is-turning'), TURN_MS);
          }
          turnState = t;
        }
        sheets.forEach((s, k) => s.classList.toggle('is-turned', k < t));

        // On a narrow viewport the window pans to the page you are on; on a
        // wide one both pages are visible and the attribute means nothing.
        book.dataset.half = narrow.matches ? (page % 2 === 0 ? 'right' : 'left') : '';

        dots.forEach((d, i) => {
          const visible = narrow.matches ? i === page : spreadOf(i) === t;
          d.setAttribute('aria-current', String(visible));
        });

        zoneBack.disabled = page === 0;
        zoneFwd.disabled = narrow.matches ? page >= total - 1 : t >= tMax;
      }

      function go(to) {
        const next = Math.max(0, Math.min(total - 1, to));
        if (next === page) return;
        page = next;
        render();
      }

      /** Forward one spread on a wide screen, one page on a narrow one. */
      function forward() {
        if (narrow.matches) return go(page + 1);
        const t = Math.min(tMax, spreadOf(page) + 1);
        go(Math.min(total - 1, t * 2));
      }

      function back() {
        if (narrow.matches) return go(page - 1);
        const t = Math.max(0, spreadOf(page) - 1);
        go(Math.min(total - 1, t * 2));
      }

      // The zones cover the pages, so a click on a link inside a page would
      // never reach it. Look at what is actually underneath the pointer first
      // and hand the click over before treating it as a page turn.
      function throughTo(e) {
        const zone = e.currentTarget;
        zone.style.pointerEvents = 'none';
        const under = document.elementFromPoint(e.clientX, e.clientY);
        zone.style.pointerEvents = '';
        const interactive = under && under.closest('a, button');
        if (interactive && !interactive.classList.contains('nb-zone')) {
          interactive.click();
          return true;
        }
        return false;
      }

      zoneBack.addEventListener('click', (e) => {
        if (!throughTo(e)) back();
      });
      zoneFwd.addEventListener('click', (e) => {
        if (!throughTo(e)) forward();
      });

      dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.nbGo))));
      dlg.querySelector('[data-nb-close]')?.addEventListener('click', () => dlg.close());

      // Details layer. The book is marked inert rather than nesting a second
      // <dialog>, which would fight this one's focus trap.
      const openDetails = () => {
        detailsLayer.hidden = false;
        viewport.inert = true;
        nav.inert = true;
        detailsLayer.querySelector('a, button')?.focus();
      };
      const closeDetails = () => {
        detailsLayer.hidden = true;
        viewport.inert = false;
        nav.inert = false;
        dlg.querySelector('[data-nb-details]')?.focus();
      };
      dlg.querySelector('[data-nb-details]')?.addEventListener('click', openDetails);
      dlg.querySelector('[data-nb-details-close]')?.addEventListener('click', closeDetails);

      dlg.addEventListener('keydown', (e) => {
        if (!detailsLayer.hidden) {
          // Esc closes the details layer first, and only then the notebook.
          if (e.key === 'Escape') {
            e.preventDefault();
            closeDetails();
          }
          return;
        }
        if (e.key === 'ArrowRight') { e.preventDefault(); forward(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); back(); }
      });

      // Swipe. Tracked on the shell so the gesture works over the nav too.
      let x0 = null;
      let y0 = null;
      shell.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;
        x0 = e.clientX;
        y0 = e.clientY;
      }, { passive: true });
      shell.addEventListener('pointerup', (e) => {
        if (x0 === null) return;
        const dx = e.clientX - x0;
        const dy = e.clientY - y0;
        x0 = null;
        // Horizontal intent only — otherwise a scroll down a page turns it.
        if (Math.abs(dx) > 56 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          if (dx < 0) forward(); else back();
        }
      }, { passive: true });

      // Crossing the breakpoint changes what "next" means, and can leave the
      // pan attribute stale on a page that is no longer the one in the window.
      narrow.addEventListener('change', render);

      // Reset on close so reopening starts at the first page.
      dlg.addEventListener('close', () => {
        page = 0;
        turnState = 0;
        detailsLayer.hidden = true;
        viewport.inert = false;
        nav.inert = false;
        sheets.forEach((s) => s.classList.remove('is-turned', 'is-turning'));
        render();
      });

      render();
    });

    // The rows stay real links; this only intercepts when the notebook exists.
    document.querySelectorAll('[data-notebook]').forEach((row) => {
      row.addEventListener('click', (e) => {
        // Never swallow a modified click — cmd/ctrl/middle still opens the
        // case study in a new tab, which is what those gestures promise.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const dlg = document.getElementById(`nb-${row.dataset.notebook}`);
        if (!dlg || typeof dlg.showModal !== 'function') return;
        e.preventDefault();
        dlg.showModal();
      });
    });
  })();
</script>
