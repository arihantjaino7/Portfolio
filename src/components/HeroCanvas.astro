---
/**
 * S1 landing background — a slow field of layered wave bands that reacts to
 * the cursor.
 *
 * Canvas 2D rather than WebGL (REDESIGN.md §2 Phase 2's original shader) or a
 * library: the whole image is soft-focus, so it can be rendered at half
 * resolution and blurred by the compositor with `filter`, which costs less
 * than a shader and has no dependency. The blur is also what gives the bands
 * their satin edge — the paths themselves are plain filled sine curves.
 *
 * Three states, in order of preference:
 *   1. JS + motion allowed  → animating, cursor-reactive.
 *   2. prefers-reduced-motion → one static frame, no rAF, no pointer listeners.
 *   3. no JS / canvas fails → the CSS shapes underneath, which are what this
 *      component rendered before and never need the canvas to paint.
 */
---

<div class="hero-bg" aria-hidden="true">
  <div class="hero-fallback"></div>
  <canvas class="hero-canvas" data-hero-waves></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-waves]');
  const ctx = canvas?.getContext('2d');
  const host = canvas?.parentElement;

  if (canvas && ctx && host) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Cursor reaction is meaningless without a real pointer, and on touch it
    // would fire on every tap-scroll.
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    const TAU = Math.PI * 2;
    // Rendered below CSS resolution: the output is blurred, so the extra
    // pixels would be thrown away by the filter anyway.
    const SCALE = 0.6;
    const STEP = 6; // px between curve samples, in canvas space
    const REACH = 320; // px of cursor influence, in CSS space
    const PULL = 0.5; // how far a band leans toward the cursor, 0..1

    /** #rrggbb -> "r, g, b", so canvas colours follow the design tokens. */
    function rgbOf(token: string, fallback: string) {
      const raw = getComputedStyle(document.documentElement)
        .getPropertyValue(token)
        .trim();
      const hex = /^#([0-9a-f]{6})$/i.exec(raw);
      if (!hex) return fallback;
      const n = parseInt(hex[1], 16);
      return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`;
    }

    const ground = rgbOf('--color-ground', '242, 241, 237');
    const ink = rgbOf('--color-text', '20, 21, 26');

    /**
     * Each band is three summed sines at different rates, so the crest never
     * repeats on a visible cycle. Speeds are in radians/second and deliberately
     * tiny — the field should read as still until you watch it. `tilt` rakes a
     * band across the frame so the forms sweep diagonally rather than sitting
     * in horizontal stripes.
     */
    const bands = [
      { base: 0.10, tilt: 0.20, a1: 0.075, a2: 0.032, a3: 0.016, f1: 1.1, f2: 2.3, f3: 3.7, s1: 0.055, s2: -0.038, s3: 0.071, p1: 0.0, p2: 1.9, p3: 4.1, alpha: 0.10, crest: 0.85 },
      { base: 0.32, tilt: -0.16, a1: 0.085, a2: 0.038, a3: 0.019, f1: 0.9, f2: 1.9, f3: 3.1, s1: -0.047, s2: 0.062, s3: -0.033, p1: 2.2, p2: 0.4, p3: 5.0, alpha: 0.09, crest: 0.9 },
      { base: 0.54, tilt: 0.24, a1: 0.09, a2: 0.042, a3: 0.02, f1: 1.3, f2: 2.1, f3: 3.4, s1: 0.041, s2: -0.057, s3: 0.029, p1: 4.4, p2: 2.7, p3: 1.2, alpha: 0.085, crest: 0.8 },
      { base: 0.74, tilt: -0.2, a1: 0.075, a2: 0.034, a3: 0.017, f1: 1.0, f2: 2.5, f3: 3.9, s1: -0.036, s2: 0.049, s3: -0.064, p1: 1.1, p2: 5.3, p3: 3.3, alpha: 0.1, crest: 0.75 },
      { base: 0.94, tilt: 0.14, a1: 0.06, a2: 0.028, a3: 0.014, f1: 1.4, f2: 2.0, f3: 3.2, s1: 0.06, s2: -0.031, s3: 0.044, p1: 3.6, p2: 1.5, p3: 0.7, alpha: 0.11, crest: 0.7 },
    ];

    let w = 0;
    let h = 0;
    // Pointer state in canvas space. `px`/`py` are the eased position the
    // curves actually read, so the bulge trails the cursor instead of snapping.
    let px = 0;
    let py = 0;
    let targetX = 0;
    let targetY = 0;
    let strength = 0; // 0 when the pointer is away, eases to 1 over the hero
    let targetStrength = 0;
    let raf = 0;
    let last = 0;
    let t = 0;
    // Cached rather than measured per pointermove — that handler can fire well
    // above frame rate, and getBoundingClientRect forces layout every time.
    let rect = { top: 0, left: 0, width: 0, height: 0 };

    function measure() {
      const r = host!.getBoundingClientRect();
      rect = { top: r.top, left: r.left, width: r.width, height: r.height };
    }

    function resize() {
      measure();
      w = Math.max(1, Math.ceil(rect.width * SCALE));
      h = Math.max(1, Math.ceil(rect.height * SCALE));
      canvas!.width = w;
      canvas!.height = h;
      draw();
    }

    function curveY(b: (typeof bands)[number], x: number) {
      const k = x / w;
      let y =
        b.base * h +
        (k - 0.5) * b.tilt * h +
        Math.sin(k * b.f1 * TAU + t * b.s1 + b.p1) * b.a1 * h +
        Math.sin(k * b.f2 * TAU + t * b.s2 + b.p2) * b.a2 * h +
        Math.sin(k * b.f3 * TAU + t * b.s3 + b.p3) * b.a3 * h;

      if (strength > 0.001) {
        // A gaussian swell in x, faded by how near the pointer is in y, so a
        // band only answers the cursor when the cursor is actually at its edge.
        const reach = REACH * SCALE;
        const dx = (x - px) / reach;
        const alongX = Math.exp(-dx * dx * 2);
        const alongY = Math.max(0, 1 - Math.abs(y - py) / reach);
        y += (py - y) * PULL * alongX * alongY * strength;
      }
      return y;
    }

    function draw() {
      if (!w || !h) return;
      ctx!.clearRect(0, 0, w, h);
      ctx!.fillStyle = `rgb(${ground})`;
      ctx!.fillRect(0, 0, w, h);

      for (const b of bands) {
        ctx!.beginPath();
        ctx!.moveTo(0, curveY(b, 0));
        for (let x = STEP; x <= w; x += STEP) ctx!.lineTo(x, curveY(b, x));
        ctx!.lineTo(w, curveY(b, w));

        // Stroke the crest before closing the path into a fill, so the lit
        // edge sits exactly on the curve. Wide, because the blur that follows
        // would erase a hairline entirely.
        ctx!.strokeStyle = `rgba(255, 255, 255, ${b.crest})`;
        ctx!.lineWidth = 9;
        ctx!.stroke();

        ctx!.lineTo(w, h);
        ctx!.lineTo(0, h);
        ctx!.closePath();
        // Shading hugs the underside of the crest and fades out well before
        // the bottom, so each band reads as a ribbon rather than a wash.
        const g = ctx!.createLinearGradient(0, b.base * h - h * 0.04, 0, b.base * h + h * 0.34);
        g.addColorStop(0, `rgba(${ink}, ${b.alpha})`);
        g.addColorStop(1, `rgba(${ink}, 0)`);
        ctx!.fillStyle = g;
        ctx!.fill();
      }
    }

    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      t += dt;

      strength += (targetStrength - strength) * Math.min(1, dt * 4);
      px += (targetX - px) * Math.min(1, dt * 6);
      py += (targetY - py) * Math.min(1, dt * 6);

      draw();
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (raf || reduce.matches) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (!raf) return;
      cancelAnimationFrame(raf);
      raf = 0;
    }

    /**
     * Bound to the window, not to the host: the hero content layer sits above
     * .hero-bg and is not a descendant of it, so listening on the host would
     * miss every pointer event that lands on the name, the statement or the
     * meta row — which is most of the hero.
     */
    function onPointerMove(e: PointerEvent) {
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const inside = x >= 0 && y >= 0 && x <= rect.width && y <= rect.height;
      targetStrength = inside ? 1 : 0;
      if (!inside) return;
      targetX = x * SCALE;
      targetY = y * SCALE;
    }

    function bindPointer() {
      if (!fine.matches || reduce.matches) return;
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      window.addEventListener('scroll', measure, { passive: true });
    }

    function unbindPointer() {
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('scroll', measure);
      targetStrength = 0;
      strength = 0;
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Nothing to animate while the hero is off screen or the tab is hidden.
    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0 },
    );
    io.observe(host);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    bindPointer();
    if (!reduce.matches) start();

    // Flipping the OS setting mid-session settles the field back to a still
    // frame rather than leaving it mid-swell.
    reduce.addEventListener('change', () => {
      if (reduce.matches) {
        stop();
        unbindPointer();
        draw();
      } else {
        bindPointer();
        start();
      }
    });
  }
</script>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-ground);
  }

  /* Oversized and blurred: the blur is what turns flat sine fills into satin,
     and the overhang keeps its soft edge outside the visible area. Sitting
     above .hero-fallback, it hides those shapes the moment it paints — so the
     fallback needs no class toggling to get out of the way. */
  .hero-canvas {
    position: absolute;
    top: -6%;
    left: -6%;
    width: 112%;
    height: 112%;
    filter: blur(min(1.8vw, 24px));
  }

  /* Shown only if the canvas never paints (no JS, no 2D context). Same shapes
     this component used before it animated. */
  .hero-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 12% 8%, rgba(20, 21, 26, 0.07), transparent 70%),
      radial-gradient(55% 40% at 88% 30%, rgba(20, 21, 26, 0.06), transparent 72%),
      radial-gradient(70% 45% at 40% 96%, rgba(20, 21, 26, 0.05), transparent 75%);
  }
</style>
