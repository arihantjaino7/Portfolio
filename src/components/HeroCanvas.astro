---
/**
 * S1 landing background — REDESIGN.md §2 Phase 2, revised to the light
 * reference: soft, blurred, flowing grey shapes on an off-white ground,
 * completely static. No WebGL, no <canvas>, no JS at all — the brief called
 * for a live-up.co.jp-style shader originally, but the reference supplied
 * later is a still, gentle wave field, so a few blurred CSS shapes reproduce
 * it exactly with zero runtime cost and nothing that can fail to load.
 */
---

<div class="hero-bg" aria-hidden="true">
  <div class="wave wave-a"></div>
  <div class="wave wave-b"></div>
  <div class="wave wave-c"></div>
  <div class="wave wave-d"></div>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--color-ground);
  }

  .wave {
    position: absolute;
    border-radius: 42% 58% 63% 37% / 48% 42% 58% 52%;
    filter: blur(min(9vw, 90px));
  }

  .wave-a {
    width: 62vw;
    height: 62vw;
    top: -22vw;
    left: -16vw;
    background: radial-gradient(closest-side, rgba(61, 90, 254, 0.1), transparent 72%);
  }

  .wave-b {
    width: 55vw;
    height: 46vw;
    top: 6vw;
    right: -14vw;
    border-radius: 55% 45% 40% 60% / 55% 60% 40% 45%;
    background: radial-gradient(closest-side, rgba(20, 21, 26, 0.07), transparent 72%);
  }

  .wave-c {
    width: 70vw;
    height: 38vw;
    bottom: -14vw;
    left: 8vw;
    border-radius: 60% 40% 45% 55% / 40% 50% 50% 60%;
    background: radial-gradient(closest-side, rgba(20, 21, 26, 0.05), transparent 75%);
  }

  .wave-d {
    width: 30vw;
    height: 30vw;
    bottom: 8vw;
    right: 12vw;
    background: radial-gradient(closest-side, rgba(61, 90, 254, 0.06), transparent 70%);
  }
</style>
