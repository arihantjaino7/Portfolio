  book: ['M2 2h5l1 1 1-1h5v11H9l-1 1-1-1H2z','M8 3v10M4 5h2M10 5h2M4 8h2M10 8h2'],
  pickaxe: ['M2 2h8v2h2v2h2v4h-2V7h-2V5H8V4H2z','M8 5l2 2-7 7H1v-2z'],
  trophy: ['M5 2h6v7l-3 2-3-2z','M5 3H2v3l3 2M11 3h3v3l-3 2M8 11v3M5 14h6'],
  mail: ['M1 4h14v9H1z','M1 4l7 6 7-6'],
  sound: ['M2 6h3l4-4v12l-4-4H2z','M12 5l2 3-2 3'],
  moon: ['M10 1H5v2H3v3H2v4h2v3h3v2h5v-2h2v-2H9V9H7V5h1V3h2z'],
  sun: ['M5 5h6v6H5z','M8 0v3M8 13v3M0 8h3M13 8h3M2 2l2 2M12 12l2 2M2 14l2-2M12 4l2-2'],
  help: ['M4 4V2h7v2h2v3h-2v2H8v2','M8 13v2'],
  arrow: ['M2 8h12M9 3l5 5-5 5'],
  close: ['M3 3l10 10M13 3L3 13'],
  map: ['M1 3l5-2 4 2 5-2v12l-5 2-4-2-5 2z','M6 1v12M10 3v12'],
  gem: ['M5 1h6l4 5-7 9L1 6z','M1 6h14M5 1L4 6l4 9 4-9-1-5'],
  shield: ['M8 1l6 2v6l-2 3-4 3-4-3-2-3V3z','M5 7l2 2 4-4'],
  branch: ['M3 2v9l3 3h5','M3 6h6l3-3V1M10 12h3v3h-3z'],
  person: ['M5 1h6v6H5z','M3 9h10v6H3z'],
};
const p = paths[name] ?? paths.gem;
---
<svg class={className} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" shape-rendering="crispEdges" aria-hidden="true">
  {p.map((d) => <path d={d} />)}
</svg>
